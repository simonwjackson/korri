{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": [
		"product/apps/portal/main.tsx",
		"product/apps/portal/routes/**/*.tsx",
		"product/apps/storybook/main.ts",
		"product/apps/storybook/preview.tsx",
		"product/platform/**/*.ts",
		"product/platform/**/*.tsx",
		"product/surfaces/**/*.ts",
		"product/surfaces/**/*.tsx",
		"product/surfaces/**/*.story.e2e.ts",
		"product/platform/react/primitives/**/*.story.e2e.ts",
		"product/surfaces/terminal/korri-cli/**/*.ts",
		"product/services/**/*.ts",
		"product/plugins/cdp-input-bridge/packages/korri-cdp-input-bridge/index.ts",
		"tools/scripts/**/*.ts",
		"tools/generators/**/*.ts",
		"tools/device/**/*.ts",
		"tools/nix/**/*.ts",
		"tools/playwright/**/*.ts",
		"tools/theme-workshop/**/*.ts",
		"tools/theme-workshop/**/*.tsx"
	],
	"ignorePatterns": [
		"old-ui/**",
		"out/**",
		"dist/**",
		"coverage/**",
		"test-results/**",
		".tmp/**",
		".tanstack/**",
		".pi/**",
		"product/apps/portal/routeTree.gen.ts",
		"product/apps/*/features/**/e2e/generated/**",
		"tools/patches/**/files/**/*",
		"**/*.d.ts"
	],
	"ignoreDependencies": [
		"bun:test",
		"pino-pretty",
		"@axe-core/playwright",
		"@radix-ui/react-dropdown-menu",
		"@radix-ui/react-scroll-area",
		"@radix-ui/react-tabs",
		"@radix-ui/react-tooltip",
		"@tiptap/extension-table-cell",
		"@tiptap/extension-table-header",
		"@tiptap/extension-table-row",
		"tsc-alias",
		"@tanstack/router-plugin",
		"framer-motion"
	],
	"ignoreExports": [
		{
			"file": "product/surfaces/web/pico/screens/kit.tsx",
			"exports": ["*"]
		},
		{
			"file": "product/plugins/acquisition-fixtures.ts",
			"exports": ["*"]
		},
		{
			"file": "product/plugins/index.ts",
			"exports": ["*"]
		},
		{
			"file": "product/plugins/portmaster/index.ts",
			"exports": ["*"]
		},
		{
			"file": "product/plugins/portmaster/src/envelope.ts",
			"exports": ["*"]
		},
		{
			"file": "product/plugins/retroarch/index.ts",
			"exports": ["*"]
		},
		{
			"file": "product/plugins/retroarch/src/materializer.ts",
			"exports": ["*"]
		},
		{
			"file": "product/plugins/retroarch/src/plugin.ts",
			"exports": ["*"]
		},
		{
			"file": "product/plugins/retroarch/src/policy.ts",
			"exports": ["*"]
		},
		{
			"file": "product/apps/portal/peers/peer-discovery.ts",
			"exports": ["PeerDiscoveryService"]
		}
	],
	"duplicates": {
		"enabled": false
	},
	"health": {
		"maxCyclomatic": 40,
		"maxCognitive": 30,
		"maxCrap": 350,
		"ignore": [
			"**/*.test.ts",
			"product/surfaces/web/pico/**",
			"product/surfaces/web/pico/**"
		]
	},
	"rules": {
		"unresolved-imports": "error",
		"unlisted-dependencies": "error",
		"boundary-violation": "error",
		"unused-files": "warn",
		"unused-exports": "warn",
		"unused-types": "warn",
		"unused-dependencies": "warn",
		"unused-dev-dependencies": "warn"
	},
	"audit": {
		"gate": "new-only"
	},
	"boundaries": {
		"zones": [
			{
				"name": "tests",
				"patterns": [
					"**/*.test.ts",
					"**/*.test.tsx",
					"**/*.steps.ts",
					"**/*.story.e2e.ts"
				]
			},
			{
				"name": "product-platform",
				"patterns": ["product/platform/**"]
			},
			{
				"name": "product-surface-pico",
				"patterns": ["product/surfaces/web/pico/**"]
			},
			{
				"name": "product-surface-shift",
				"patterns": ["product/surfaces/web/shift/**"]
			},
			{
				"name": "product-surfaces-web",
				"patterns": ["product/surfaces/web/**"]
			},
			{
				"name": "product-surfaces-terminal",
				"patterns": ["product/surfaces/terminal/**"]
			},
			{
				"name": "product-apps",
				"patterns": ["product/apps/**"]
			},
			{
				"name": "product-services",
				"patterns": ["product/services/**"]
			},
			{
				"name": "repo-tools",
				"patterns": ["tools/**"]
			}
		],
		"rules": [
			{
				"from": "tests",
				"allow": [
					"repo-tools",
					"product-apps",
					"product-services",
					"product-platform",
					"product-surfaces-web",
					"product-surfaces-terminal",
					"product-surface-pico",
					"product-surface-shift"
				]
			},
			{
				"from": "product-platform",
				"allow": [
					"product-surfaces-web",
					"product-surfaces-terminal",
					"product-surface-pico",
					"product-surface-shift"
				]
			},
			{
				"from": "product-surfaces-web",
				"allow": ["product-platform"]
			},
			{
				"from": "product-surface-pico",
				"allow": ["product-platform", "repo-tools"]
			},
			{
				"from": "product-surface-shift",
				"allow": ["product-platform", "repo-tools"]
			},
			{
				"from": "product-surfaces-terminal",
				"allow": ["product-platform", "product-apps", "product-services"]
			},
			{
				"from": "product-apps",
				"allow": [
					"product-services",
					"product-platform",
					"product-surfaces-web",
					"product-surfaces-terminal"
				]
			},
			{
				"from": "product-services",
				"allow": ["product-apps", "product-platform"]
			},
			{
				"from": "repo-tools",
				"allow": [
					"product-apps",
					"product-services",
					"product-platform",
					"product-surfaces-web",
					"product-surfaces-terminal",
					"product-surface-pico",
					"product-surface-shift"
				]
			}
		]
	}
}
