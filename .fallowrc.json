{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": [
		"electrobun.config.ts",
		"korri/deploy/portal/main.tsx",
		"korri/deploy/desktop/main.ts",
		"korri/deploy/storybook/main.ts",
		"product/apps/cli/**/*.ts",
		"product/services/**/*.ts",
		"tools/scripts/**/*.ts",
		"tools/generators/**/*.ts",
		"tools/desktop/**/*.ts",
		"tools/device/**/*.ts",
		"tools/nix/**/*.ts",
		"tools/playwright/**/*.ts"
	],
	"ignorePatterns": [
		"old-ui/**",
		"out/**",
		"dist/**",
		"coverage/**",
		"test-results/**",
		".tmp/**",
		".tanstack/**",
		".pi/**",
		"korri/deploy/portal/routeTree.gen.ts",
		"korri/products/*/features/**/e2e/generated/**",
		"tools/patches/**/files/**/*",
		"**/*.d.ts"
	],
	"ignoreDependencies": [
		"bun:test",
		"pino-pretty",
		"@axe-core/playwright",
		"@radix-ui/react-dropdown-menu",
		"@radix-ui/react-scroll-area",
		"@radix-ui/react-tabs",
		"@radix-ui/react-tooltip",
		"@tiptap/extension-table-cell",
		"@tiptap/extension-table-header",
		"@tiptap/extension-table-row",
		"tsc-alias",
		"@tanstack/router-plugin",
		"framer-motion"
	],
	"rules": {
		"unresolved-imports": "error",
		"unlisted-dependencies": "error",
		"boundary-violation": "error",
		"unused-files": "warn",
		"unused-exports": "warn",
		"unused-types": "warn",
		"unused-dependencies": "warn",
		"unused-dev-dependencies": "warn"
	},
	"audit": {
		"gate": "new-only"
	},
	"boundaries": {
		"zones": [
			{
				"name": "tests",
				"patterns": [
					"**/*.test.ts",
					"**/*.test.tsx",
					"**/*.steps.ts",
					"**/*.story.e2e.ts"
				]
			},
			{ "name": "deploy", "patterns": ["korri/deploy/**"] },
			{ "name": "app", "patterns": ["korri/products/app/**"] },
			{ "name": "product-apps", "patterns": ["product/apps/**"] },
			{ "name": "product-services", "patterns": ["product/services/**"] },
			{ "name": "shared", "patterns": ["korri/shared/**"] },
			{ "name": "repo-tools", "patterns": ["tools/**"] }
		],
		"rules": [
			{
				"from": "tests",
				"allow": [
					"app",
					"shared",
					"repo-tools",
					"deploy",
					"product-apps",
					"product-services"
				]
			},
			{ "from": "deploy", "allow": ["app", "shared", "product-apps"] },
			{
				"from": "app",
				"allow": ["shared", "product-apps", "product-services"]
			},
			{
				"from": "product-apps",
				"allow": ["app", "shared", "product-services"]
			},
			{
				"from": "product-services",
				"allow": ["app", "shared", "product-apps"]
			},
			{ "from": "shared", "allow": [] },
			{
				"from": "repo-tools",
				"allow": ["app", "shared", "deploy", "product-apps", "product-services"]
			}
		]
	}
}
