# Optional local topology for Korri Device flake runs.
# Copy to local.env or pass with `just --dotenv-path local.<target>.env ...`.
# Keep real hostnames and private paths out of committed files.

# Destination to run on. Leave unset to run on the current machine.
# DEVICE_HOST=root@example-device

# Extra SSH options for the destination connection.
# DEVICE_SSH_OPTS=-p 2222

# Environment assignments to prefix onto the nix run command. Useful when
# running GUI apps from SSH into an existing compositor session.
# DEVICE_RUN_ENV="XDG_RUNTIME_DIR=/run/user/2000 WAYLAND_DISPLAY=wayland-1 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/2000/bus DISPLAY=:0"

# Override the source host used when DEVICE_HOST is set and KORRI_FLAKE_REF is unset.
# By default the helper uses the local machine hostname.
# KORRI_SOURCE_HOST=source-host.example

# Explicit flake ref. Leave unset for `.` locally or inferred git+ssh://<source-host><repo-root> remotely.
# KORRI_FLAKE_REF=git+ssh://source-host.example/path/to/korri

# App output to run from the selected flake.
# KORRI_APP=korri-desktop-device

# Advanced one-off builder override. Prefer configuring builders in the Nix config
# of the machine that runs Nix; for DEVICE_HOST runs, that is the destination.
# NIX_BUILDERS=ssh://builder.example aarch64-linux - 8 1
# NIX_MAX_JOBS=0

# Allow non-interactive runs to proceed when a Git flake ref will omit uncommitted changes.
# KORRI_ALLOW_DIRTY_FLAKE_RUN=1

# SteamGridDB API token for the boxbuster web surface's cover-art proxy
# (product/surfaces/web/boxbuster). Injected server-side by the Vite dev proxy,
# never shipped to the client. A throwaway dev key is baked in as a fallback, so
# this is only needed to override it.
# SGDB_KEY=your-steamgriddb-token
