+  void send_runtime_settings_ack_payload(session_t *session, const Ack &plaintext) {
+    std::array<std::uint8_t, sizeof(control_encrypted_t) + crypto::cipher::round_to_pkcs7_padded(sizeof(plaintext)) + crypto::cipher::tag_size>
+      encrypted_payload;
+    auto payload = encode_control(session, util::view(plaintext), encrypted_payload);
+    if (session->broadcast_ref->control_server.send(payload, session->control.peer)) {
+      BOOST_LOG(warning) << "live-settings-mvp: failed to send runtime settings ack"sv;
+    }
+  }
+
+  void send_runtime_settings_ack(session_t *session, const video::runtime_bitrate_ack_t &ack) {
+    if (!session->control.peer) {
+      BOOST_LOG(warning) << "live-settings-mvp: no control peer for runtime settings ack"sv;
+      return;
+    }
+
+    if (ack.status == video::RUNTIME_SETTINGS_STATUS_APPLIED) {
+      if (ack.operation == video::RUNTIME_SETTINGS_OPERATION_SET_BITRATE_KBPS) {
+        session->control.runtime_settings_applied_bitrate_kbps = ack.applied_value;
+      } else if (ack.operation == video::RUNTIME_SETTINGS_OPERATION_SET_FPS) {
+        session->control.runtime_settings_applied_fps = ack.applied_value;
+      } else if (ack.operation == video::RUNTIME_SETTINGS_OPERATION_SET_RESOLUTION) {
+        session->control.runtime_settings_applied_width = ack.applied_width;
+        session->control.runtime_settings_applied_height = ack.applied_height;
+      }
+    }
+
+    if (ack.operation == video::RUNTIME_SETTINGS_OPERATION_SET_RESOLUTION) {
+      control_runtime_settings_resolution_ack_t plaintext {};
+      plaintext.header.type = packetTypes[IDX_RUNTIME_SETTINGS_ACK];
+      plaintext.header.payloadLength = sizeof(control_runtime_settings_resolution_ack_t) - sizeof(control_header_v2);
+      plaintext.request_id = ack.request_id;
+      plaintext.operation = ack.operation;
+      plaintext.status = ack.status;
+      plaintext.applied_width = ack.applied_width;
+      plaintext.applied_height = ack.applied_height;
+      plaintext.reason = ack.reason;
+      send_runtime_settings_ack_payload(session, plaintext);
+      return;
+    }
+
+    control_runtime_settings_ack_t plaintext {};
+    plaintext.header.type = packetTypes[IDX_RUNTIME_SETTINGS_ACK];
+    plaintext.header.payloadLength = sizeof(control_runtime_settings_ack_t) - sizeof(control_header_v2);
+    plaintext.request_id = ack.request_id;
+    plaintext.operation = ack.operation;
+    plaintext.status = ack.status;
+    plaintext.applied_value = ack.applied_value;
+    plaintext.reason = ack.reason;
+    send_runtime_settings_ack_payload(session, plaintext);
+  }
+
+  void send_runtime_settings_capability_ack(session_t *session, std::uint32_t request_id, bool enabled) {
+    if (!session->control.peer) {
+      BOOST_LOG(warning) << "live-settings-mvp: no control peer for runtime settings capability ack"sv;
+      return;
+    }
+
+    auto h264_session = session->config.monitor.videoFormat == 0;
+    auto vaapi_requested = config::video.encoder == "vaapi"sv;
+    auto runtime_supported = enabled && h264_session && vaapi_requested;
+    std::uint32_t supported_operations = 0;
+    std::uint32_t proof_gated_operations = 0;
+    std::uint16_t status = enabled ? video::RUNTIME_SETTINGS_STATUS_APPLIED : video::RUNTIME_SETTINGS_STATUS_DISABLED;
+    std::uint16_t reason = enabled ? video::RUNTIME_SETTINGS_REASON_UNSUPPORTED_ENCODER : video::RUNTIME_SETTINGS_REASON_GATE_DISABLED;
+    if (runtime_supported) {
+      supported_operations |= 1u << video::RUNTIME_SETTINGS_OPERATION_SET_BITRATE_KBPS;
+      supported_operations |= 1u << video::RUNTIME_SETTINGS_OPERATION_SET_FPS;
+      proof_gated_operations |= 1u << video::RUNTIME_SETTINGS_OPERATION_SET_RESOLUTION;
+      reason = video::RUNTIME_SETTINGS_REASON_NONE;
+    }
+
+    control_runtime_settings_capability_ack_t plaintext {};
+    plaintext.header.type = packetTypes[IDX_RUNTIME_SETTINGS_ACK];
+    plaintext.header.payloadLength = sizeof(control_runtime_settings_capability_ack_t) - sizeof(control_header_v2);
+    plaintext.request_id = request_id;
+    plaintext.operation = video::RUNTIME_SETTINGS_OPERATION_QUERY_CAPABILITIES;
+    plaintext.status = status;
+    plaintext.reason = reason;
+    plaintext.supported_operations = supported_operations;
+    plaintext.proof_gated_operations = proof_gated_operations;
+    plaintext.min_bitrate_kbps = runtime_supported ? 1 : 0;
+    plaintext.max_bitrate_kbps = 0;
+    plaintext.max_fps = session->control.runtime_settings_launch_fps;
+    plaintext.launch_bitrate_kbps = session->control.runtime_settings_launch_bitrate_kbps;
+    plaintext.launch_fps = session->control.runtime_settings_launch_fps;
+    plaintext.launch_width = session->control.runtime_settings_launch_width;
+    plaintext.launch_height = session->control.runtime_settings_launch_height;
+    plaintext.current_bitrate_kbps = session->control.runtime_settings_applied_bitrate_kbps;
+    plaintext.current_fps = session->control.runtime_settings_applied_fps;
+    plaintext.current_width = session->control.runtime_settings_applied_width;
+    plaintext.current_height = session->control.runtime_settings_applied_height;
+    send_runtime_settings_ack_payload(session, plaintext);
+  }
