+static int moonlight_local_control_dispatch_runtime_command(struct json_object* id, struct json_object* request, const char* method_name, int client_fd) {
+  struct json_object* params = NULL;
+  json_object_object_get_ex(request, "params", &params);
+  if (params == NULL || json_object_get_type(params) != json_type_object) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32602, "missing params", "invalid"));
+    return 0;
+  }
+
+  uint16_t operation;
+  uint32_t value;
+  struct json_object* raw_value = NULL;
+  if (strcmp(method_name, MOONLIGHT_LC_COMMAND_RUNTIME_SET_BITRATE) == 0) {
+    operation = MOONLIGHT_LC_OPERATION_SET_BITRATE_KBPS;
+    json_object_object_get_ex(params, "bitrateKbps", &raw_value);
+  }
+  else {
+    operation = MOONLIGHT_LC_OPERATION_SET_FPS;
+    json_object_object_get_ex(params, "fps", &raw_value);
+  }
+
+  if (raw_value == NULL || json_object_get_type(raw_value) != json_type_int) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32602, "invalid command value", "invalid"));
+    return 0;
+  }
+  value = (uint32_t) json_object_get_int(raw_value);
+
+  uint64_t now = moonlight_local_control_monotonic_ms();
+  pthread_mutex_lock(&control.lock);
+  int controller = strcmp(control.authority, "controller") == 0;
+  int has_capability = control.has_runtime_capability;
+  int supported = moonlight_local_control_operation_supported_locked(operation);
+  uint32_t min_bitrate = control.min_bitrate_kbps;
+  uint32_t max_bitrate = control.max_bitrate_kbps;
+  uint32_t max_fps = control.max_fps;
+  uint64_t last_command_at = control.last_command_at_ms;
+  pthread_mutex_unlock(&control.lock);
+
+  if (!controller) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32000, "command authority required", "unauthorized"));
+    return 0;
+  }
+  if (!has_capability) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32000, "runtime settings capability not ready", "not-streaming"));
+    return 0;
+  }
+  if (!supported) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32000, "runtime command unsupported", "unsupported"));
+    return 0;
+  }
+  if (last_command_at != 0 && now - last_command_at < MOONLIGHT_CONTROL_MIN_COMMAND_INTERVAL_MS) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32000, "runtime command interval conflict", "conflict"));
+    return 0;
+  }
+  if (operation == MOONLIGHT_LC_OPERATION_SET_BITRATE_KBPS && (value < min_bitrate || value > max_bitrate)) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32602, "bitrate out of bounds", "invalid"));
+    return 0;
+  }
+  if (operation == MOONLIGHT_LC_OPERATION_SET_FPS && (value < MOONLIGHT_CONTROL_MIN_FPS || value > max_fps)) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32602, "fps out of bounds", "invalid"));
+    return 0;
+  }
+
+  uint32_t command_id = moonlight_local_control_next_command_id();
+  int send_result = LiSendSunshineRuntimeSettingsMvp(command_id, operation, value, 0);
+  if (send_result != 0) {
+    const char* tag = send_result == -5 ? "conflict" : (send_result == -6 ? "unsupported" : "failed");
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32000, "runtime command dispatch failed", tag));
+    return 0;
+  }
+
+  pthread_mutex_lock(&control.lock);
+  control.last_command_at_ms = now;
+  pthread_mutex_unlock(&control.lock);
+
+  struct json_object* accepted = json_object_new_object();
+  json_object_object_add(accepted, "_tag", json_object_new_string("command.accepted"));
+  json_object_object_add(accepted, "requestId", json_object_new_int64((int64_t) command_id));
+  json_object_object_add(accepted, "command", json_object_new_string(method_name));
+  moonlight_local_control_write_json(client_fd, moonlight_local_control_success(id, accepted));
+  return 1;
+}
+
+static uint32_t moonlight_local_control_next_command_id(void) {
+  pthread_mutex_lock(&control.lock);
+  uint32_t command_id = control.next_command_id++;
+  if (control.next_command_id == 0)
+    control.next_command_id = 100000;
+  pthread_mutex_unlock(&control.lock);
+  return command_id;
+}
+
+static uint64_t moonlight_local_control_monotonic_ms(void) {
+  struct timespec ts;
+  if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+    return 0;
+  return ((uint64_t) ts.tv_sec * 1000u) + ((uint64_t) ts.tv_nsec / 1000000u);
+}
+
+static int moonlight_local_control_add_subscriber(int fd) {
+  pthread_mutex_lock(&control.lock);
+  for (int i = 0; i < MOONLIGHT_CONTROL_MAX_CLIENTS; i++) {
+    if (control.subscribers[i].fd == fd) {
+      control.subscribers[i].subscribed_seq = control.seq;
+      pthread_mutex_unlock(&control.lock);
+      return 1;
+    }
+  }
+  for (int i = 0; i < MOONLIGHT_CONTROL_MAX_CLIENTS; i++) {
+    if (control.subscribers[i].fd <= 0) {
+      control.subscribers[i].fd = fd;
+      control.subscribers[i].subscribed_seq = control.seq;
+      pthread_mutex_unlock(&control.lock);
+      return 1;
+    }
+  }
+  pthread_mutex_unlock(&control.lock);
+  moonlight_local_control_evict_slow_subscriber(fd);
+  return 0;
+}
+
+static void moonlight_local_control_remove_subscriber(int fd) {
+  pthread_mutex_lock(&control.lock);
+  for (int i = 0; i < MOONLIGHT_CONTROL_MAX_CLIENTS; i++) {
+    if (control.subscribers[i].fd == fd) {
+      control.subscribers[i].fd = -1;
+      control.subscribers[i].subscribed_seq = 0;
+    }
+  }
+  pthread_mutex_unlock(&control.lock);
+}
+
+static void moonlight_local_control_evict_slow_subscriber(int fd) {
+  moonlight_local_control_remove_subscriber(fd);
+}
+
+static void moonlight_local_control_emit_event(struct json_object* event) {
+  int fds[MOONLIGHT_CONTROL_MAX_CLIENTS];
+  int count = 0;
+  pthread_mutex_lock(&control.lock);
+  for (int i = 0; i < MOONLIGHT_CONTROL_MAX_CLIENTS; i++) {
+    if (control.subscribers[i].fd > 0)
+      fds[count++] = control.subscribers[i].fd;
+  }
+  pthread_mutex_unlock(&control.lock);
+
+  const char* serialized = json_object_to_json_string_ext(event, JSON_C_TO_STRING_PLAIN);
+  size_t len = strlen(serialized);
+  for (int i = 0; i < count; i++) {
+    if (send(fds[i], serialized, len, MSG_NOSIGNAL | MSG_DONTWAIT) < 0 || send(fds[i], "\n", 1, MSG_NOSIGNAL | MSG_DONTWAIT) < 0)
+      moonlight_local_control_evict_slow_subscriber(fds[i]);
+  }
+  json_object_put(event);
+}
+
+static void moonlight_local_control_emit_runtime_command_result(uint32_t request_id, uint16_t operation, uint16_t status, uint16_t reason) {
+  const char* command = moonlight_local_control_command_for_operation(operation);
+  const char* status_label = moonlight_local_control_status_for_runtime_status(status, reason);
+  if (command == NULL)
+    return;
+
+  uint64_t seq;
+  pthread_mutex_lock(&control.lock);
+  control.seq++;
+  seq = control.seq;
+  control.has_last_command = 1;
+  control.last_request_id = request_id;
+  snprintf(control.last_command, sizeof(control.last_command), "%s", command);
+  snprintf(control.last_status, sizeof(control.last_status), "%s", status_label);
+  control.last_reason = reason;
+  if (operation == MOONLIGHT_LC_OPERATION_SET_BITRATE_KBPS && status == MOONLIGHT_LC_STATUS_APPLIED)
+    control.bitrate_kbps = control.bitrate_kbps;
+  control.moonlight_local_control_event_history[seq % MOONLIGHT_CONTROL_EVENT_HISTORY].seq = seq;
+  snprintf(control.moonlight_local_control_event_history[seq % MOONLIGHT_CONTROL_EVENT_HISTORY].name, sizeof(control.moonlight_local_control_event_history[0].name), "%s", "runtime.commandResult");
+  pthread_mutex_unlock(&control.lock);
+
+  moonlight_local_control_emit_event(moonlight_local_control_runtime_command_event(seq, request_id, command, status_label, reason));
+}
+
+static void moonlight_local_control_runtime_settings_observer(const SS_RUNTIME_SETTINGS_MVP_OBSERVER_EVENT* event, void* context) {
+  (void) context;
+  if (event == NULL)
+    return;
+
+  if (event->isCapability) {
+    pthread_mutex_lock(&control.lock);
+    control.has_runtime_capability = event->status == MOONLIGHT_LC_STATUS_APPLIED;
+    control.supported_operations = event->supportedOperations;
+    control.proof_gated_operations = event->proofGatedOperations;
+    control.min_bitrate_kbps = event->minBitrateKbps == 0 ? MOONLIGHT_CONTROL_MIN_BITRATE_KBPS : event->minBitrateKbps;
+    control.max_bitrate_kbps = event->maxBitrateKbps == 0 ? MOONLIGHT_CONTROL_MAX_BITRATE_KBPS : event->maxBitrateKbps;
+    control.max_fps = event->maxFps == 0 ? MOONLIGHT_CONTROL_MAX_FPS : event->maxFps;
+    control.bitrate_kbps = event->currentBitrateKbps == 0 ? control.bitrate_kbps : (int) event->currentBitrateKbps;
+    control.fps = event->currentFps == 0 ? control.fps : (int) event->currentFps;
+    control.width = event->currentWidth == 0 ? control.width : (int) event->currentWidth;
+    control.height = event->currentHeight == 0 ? control.height : (int) event->currentHeight;
+    control.seq++;
+    pthread_mutex_unlock(&control.lock);
+    return;
+  }
+
+  if (event->isTerminal)
+    moonlight_local_control_emit_runtime_command_result(event->requestId, event->operation, event->status, event->reason);
+}
+
+static const char* moonlight_local_control_command_for_operation(uint16_t operation) {
+  if (operation == MOONLIGHT_LC_OPERATION_SET_BITRATE_KBPS)
+    return MOONLIGHT_LC_COMMAND_RUNTIME_SET_BITRATE;
+  if (operation == MOONLIGHT_LC_OPERATION_SET_FPS)
+    return MOONLIGHT_LC_COMMAND_RUNTIME_SET_FPS;
+  return NULL;
+}
+
+static const char* moonlight_local_control_status_for_runtime_status(uint16_t status, uint16_t reason) {
+  (void) reason;
+  if (status == MOONLIGHT_LC_STATUS_APPLIED)
+    return "applied";
+  if (status == MOONLIGHT_LC_STATUS_INVALID)
+    return "invalid";
+  if (status == MOONLIGHT_LC_STATUS_DISABLED)
+    return "disabled";
+  return "failed";
+}
+
+static int moonlight_local_control_operation_supported_locked(uint16_t operation) {
+  if (operation == MOONLIGHT_LC_OPERATION_SET_RESOLUTION)
+    return 0;
+  return (control.supported_operations & (1u << operation)) != 0;
+}
