From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Simon W. Jackson" <simon@simonwjackson.io>
Date: Mon, 1 Jun 2026 15:12:00 -0600
Subject: [PATCH] Diagnose v4l2m2m frame content hashes

---
 src/video/v4l2m2m.c | 57 +++++++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 55 insertions(+), 2 deletions(-)

--- a/src/video/v4l2m2m.c
+++ b/src/video/v4l2m2m.c
@@ -1472,6 +1472,49 @@
   direct_quad_visible_h = frame->height;
 }
 
+static uint64_t sample_frame_hash(AVFrame *frame) {
+  uint64_t hash = 1469598103934665603ULL;
+  int planes = frame->format == AV_PIX_FMT_NV12 ? 2 : 1;
+  for (int plane = 0; plane < planes; ++plane) {
+    int plane_h = plane == 0 ? frame->height : frame->height / 2;
+    int plane_w = plane == 0 ? frame->width : frame->width;
+    if (!frame->data[plane] || frame->linesize[plane] <= 0)
+      continue;
+    int row_step = plane_h > 32 ? plane_h / 32 : 1;
+    int col_step = plane_w > 64 ? plane_w / 64 : 1;
+    for (int y = 0; y < plane_h; y += row_step) {
+      const uint8_t *row = frame->data[plane] + (size_t)y * frame->linesize[plane];
+      for (int x = 0; x < plane_w; x += col_step) {
+        hash ^= row[x];
+        hash *= 1099511628211ULL;
+      }
+    }
+  }
+  return hash;
+}
+
+static void debug_dump_nv12_luma(AVFrame *frame, int draw_count) {
+  if (frame->format != AV_PIX_FMT_NV12 || frame->width != 1280)
+    return;
+  if (draw_count % 120 != 0)
+    return;
+
+  char path[256];
+  snprintf(path, sizeof(path), "/storage/probe-a-resolution/run/frame-dumps/frame-%06d-%dx%d.pgm",
+           draw_count, frame->width, frame->height);
+  FILE *fp = fopen(path, "wb");
+  if (!fp)
+    return;
+  int w = frame_visible_width(frame);
+  int h = frame_visible_height(frame);
+  fprintf(fp, "P5\n%d %d\n255\n", w, h);
+  for (int y = 0; y < h; ++y) {
+    const uint8_t *row = frame->data[0] + (size_t)y * frame->linesize[0];
+    fwrite(row, 1, w, fp);
+  }
+  fclose(fp);
+}
+
 static void draw_frame_direct_dmabuf(AVFrame *frame) {
   if (!gl_ctx || !egl_create_image || !egl_destroy_image || !gl_image_target_texture)
     return;
@@ -1558,19 +1601,27 @@
 static void draw_frame_drm_prime(AVFrame *frame);
 static void draw_frame_nv12(AVFrame *frame);
 static void draw_frame_direct_dmabuf(AVFrame *frame);
+static int reset_sdl_renderer_after_resolution_change(int frame_w, int frame_h);
 
 static void draw_frame(AVFrame *frame) {
   static int draw_count = 0;
   int visible_w = frame_visible_width(frame);
   int visible_h = frame_visible_height(frame);
   if (++draw_count <= 3 || draw_count % 120 == 0)
-    LOG("draw_frame: #%d size=%dx%d visible=%dx%d crop=[%zu,%zu,%zu,%zu] fmt=%s linesize=[%d,%d,%d,%d]",
+    LOG("draw_frame: #%d size=%dx%d visible=%dx%d crop=[%zu,%zu,%zu,%zu] fmt=%s hash=%016" PRIx64 " linesize=[%d,%d,%d,%d]",
         draw_count, frame->width, frame->height, visible_w, visible_h,
         frame->crop_left, frame->crop_top, frame->crop_right, frame->crop_bottom,
-        av_get_pix_fmt_name(frame->format),
+        av_get_pix_fmt_name(frame->format), sample_frame_hash(frame),
         frame->linesize[0], frame->linesize[1],
         frame->linesize[2], frame->linesize[3]);
   pump_sdl_window_events();
+  if (sdl_presenter_reset_requested) {
+    LOG("draw_frame: applying SDL presenter reset for visible=%dx%d", visible_w, visible_h);
+    sdl_presenter_reset_requested = false;
+    reset_sdl_renderer_after_resolution_change(visible_w, visible_h);
+    pump_sdl_window_events();
+  }
+  debug_dump_nv12_luma(frame, draw_count);
   update_render_geometry(visible_w, visible_h);
   if (direct_dmabuf_present && direct_v4l2 && frame->format == AV_PIX_FMT_NV12) {
     draw_frame_direct_dmabuf(frame);
-- 
