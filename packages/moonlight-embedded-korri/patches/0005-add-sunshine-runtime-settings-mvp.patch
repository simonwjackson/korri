+int LiSendSunshineRuntimeSettingsMvp(uint32_t requestId, uint16_t operation, uint32_t value) {
+    SS_RUNTIME_SETTINGS_MVP_REQUEST request;
+
+    if (!IS_SUNSHINE()) {
+        Limelog("live-settings-mvp: runtime settings request skipped reason=not_sunshine\n");
+        return -1;
+    }
+
+    if (!encryptedControlStream || peer == NULL) {
+        Limelog("live-settings-mvp: runtime settings request skipped reason=control_not_ready encrypted=%d peer=%p\n",
+                encryptedControlStream ? 1 : 0, peer);
+        return -2;
+    }
+
+    request.requestId = LE32(requestId);
+    request.operation = LE16(operation);
+    request.reserved = 0;
+    request.value = LE32(value);
+
+    if (!sendMessageAndForget(SS_RUNTIME_SETTINGS_MVP_REQUEST_PTYPE,
+                              sizeof(request),
+                              &request,
+                              CTRL_CHANNEL_GENERIC,
+                              ENET_PACKET_FLAG_RELIABLE,
+                              false)) {
+        Limelog("live-settings-mvp: runtime settings request failed request_id=%u operation=%u value=%u\n", requestId, operation, value);
+        return -3;
+    }
+
+    if (operation == 2) {
+        Limelog("live-settings-mvp: runtime settings request sent request_id=%u operation=2 fps=%u packet=0x5504\n",
+                requestId, value);
+    }
+    else {
+        Limelog("live-settings-mvp: runtime settings request sent request_id=%u operation=1 bitrate_kbps=%u packet=0x5504\n",
+                requestId, value);
+    }
+    return 0;
+}
