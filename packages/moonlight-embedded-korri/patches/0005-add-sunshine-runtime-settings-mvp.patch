+int LiSendSunshineRuntimeSettingsMvp(uint32_t requestId, uint16_t operation, uint32_t value, uint32_t secondaryValue) {
+    SS_RUNTIME_SETTINGS_MVP_REQUEST_PREFIX queryRequest;
+    SS_RUNTIME_SETTINGS_MVP_REQUEST request;
+    SS_RUNTIME_SETTINGS_MVP_RESOLUTION_REQUEST resolutionRequest;
+    const void* payload;
+    short payloadLength;
+
+    if (!IS_SUNSHINE()) {
+        Limelog("live-settings-mvp: runtime settings request skipped reason=not_sunshine\n");
+        return -1;
+    }
+
+    if (operation > SS_RUNTIME_SETTINGS_MVP_OPERATION_MAX) {
+        Limelog("live-settings-mvp: command request_id=%u operation=%u outcome=locally-rejected reason=unsupported-operation\n", requestId, operation);
+        return -4;
+    }
+
+    if (!encryptedControlStream || peer == NULL) {
+        Limelog("live-settings-mvp: command request_id=%u operation=%u outcome=locally-rejected reason=control-not-ready encrypted=%d peer=%p\n",
+                requestId, operation, encryptedControlStream ? 1 : 0, peer);
+        return -2;
+    }
+
+    if (!runtime_settings_mvp_record_sent(requestId, operation)) {
+        return -5;
+    }
+
+    if (operation == SS_RUNTIME_SETTINGS_MVP_OPERATION_QUERY_CAPABILITIES) {
+        queryRequest.requestId = LE32(requestId);
+        queryRequest.operation = LE16(operation);
+        queryRequest.reserved = 0;
+        payload = &queryRequest;
+        payloadLength = sizeof(queryRequest);
+    }
+    else if (operation == SS_RUNTIME_SETTINGS_MVP_OPERATION_SET_RESOLUTION) {
+        resolutionRequest.requestId = LE32(requestId);
+        resolutionRequest.operation = LE16(operation);
+        resolutionRequest.reserved = 0;
+        resolutionRequest.width = LE32(value);
+        resolutionRequest.height = LE32(secondaryValue);
+        payload = &resolutionRequest;
+        payloadLength = sizeof(resolutionRequest);
+    }
+    else {
+        request.requestId = LE32(requestId);
+        request.operation = LE16(operation);
+        request.reserved = 0;
+        request.value = LE32(value);
+        payload = &request;
+        payloadLength = sizeof(request);
+    }
+
+    if (!sendMessageAndForget(SS_RUNTIME_SETTINGS_MVP_REQUEST_PTYPE,
+                              payloadLength,
+                              payload,
+                              CTRL_CHANNEL_GENERIC,
+                              ENET_PACKET_FLAG_RELIABLE,
+                              false)) {
+        Limelog("live-settings-mvp: runtime settings request failed request_id=%u operation=%u value=%u\n", requestId, operation, value);
+        runtime_settings_mvp_record_send_failed(requestId, operation);
+        return -3;
+    }
+
+    if (operation == SS_RUNTIME_SETTINGS_MVP_OPERATION_QUERY_CAPABILITIES) {
+        Limelog("live-settings-mvp: runtime settings request sent request_id=%u operation=0 capability query packet=0x5504\n",
+                requestId);
+    }
+    else if (operation == SS_RUNTIME_SETTINGS_MVP_OPERATION_SET_RESOLUTION) {
+        Limelog("live-settings-mvp: runtime settings request sent request_id=%u operation=3 resolution=%ux%u packet=0x5504\n",
+                requestId, value, secondaryValue);
+    }
+    else if (operation == SS_RUNTIME_SETTINGS_MVP_OPERATION_SET_FPS) {
+        Limelog("live-settings-mvp: runtime settings request sent request_id=%u operation=2 fps=%u packet=0x5504\n",
+                requestId, value);
+    }
+    else {
+        Limelog("live-settings-mvp: runtime settings request sent request_id=%u operation=1 bitrate_kbps=%u packet=0x5504\n",
+                requestId, value);
+    }
+    return 0;
+}
+
+int LiQuerySunshineRuntimeSettingsMvpCapabilities(uint32_t requestId) {
+    return LiSendSunshineRuntimeSettingsMvp(requestId, SS_RUNTIME_SETTINGS_MVP_OPERATION_QUERY_CAPABILITIES, 0, 0);
+}
