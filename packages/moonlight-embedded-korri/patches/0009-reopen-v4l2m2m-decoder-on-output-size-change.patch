   }
 
   /* SDL2 GL window. The stream size and the compositor-visible window
@@ -1803,6 +1878,13 @@
   direct_dmabuf_present = false;
   if (direct_v4l2) direct_v4l2_cleanup();
   if (pkt)        av_packet_free(&pkt);
+  stream_seen_output_frame = false;
+  stream_video_format = 0;
+  stream_width = 0;
+  stream_height = 0;
+  stream_output_width = 0;
+  stream_output_height = 0;
+  stream_decoder_epoch = 0;
   if (codec_ctx)  avcodec_free_context(&codec_ctx);
   if (nal_buf)    { free(nal_buf); nal_buf = NULL; nal_size = 0; }
 }
@@ -1836,13 +1918,37 @@
 
   int ret;
+  bool request_recovery_idr_after_submit = false;
+  int received_frames = 0;
   while ((ret = avcodec_receive_frame(codec_ctx, f)) == 0) {
+    if (++received_frames > 8) {
+      LOG("submit: decoder receive frame cap reached epoch=%d; yielding video receive thread", stream_decoder_epoch);
+      av_frame_unref(f);
+      ret = AVERROR(EAGAIN);
+      break;
+    }
-    static bool logged_first_frame = false;
-    if (!logged_first_frame) {
-      LOG("submit: first frame from decoder format=%s (DRM_PRIME=%s)",
-          av_get_pix_fmt_name(f->format),
+    static int logged_first_frame_epoch = -1;
+    if (logged_first_frame_epoch != stream_decoder_epoch) {
+      LOG("submit: first frame from decoder epoch=%d format=%s size=%dx%d (DRM_PRIME=%s)",
+          stream_decoder_epoch,
+          av_get_pix_fmt_name(f->format), f->width, f->height,
           f->format == AV_PIX_FMT_DRM_PRIME ? "YES" : "no");
