Subject: [PATCH] Reopen v4l2m2m decoder on output size changes

---
 src/video/v4l2m2m.c | 216 ++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 199 insertions(+), 17 deletions(-)

--- a/src/video/v4l2m2m.c	2026-05-31 19:48:49.368578244 -0600
+++ b/src/video/v4l2m2m.c	2026-05-31 19:55:55.926349667 -0600
@@ -72,6 +72,13 @@
 static AVPacket      *pkt       = NULL;
 static void          *nal_buf   = NULL;
 static size_t        nal_size   = 0;
+static bool           stream_seen_output_frame = false;
+static int            stream_video_format = 0;
+static int            stream_width = 0;
+static int            stream_height = 0;
+static int            stream_output_width = 0;
+static int            stream_output_height = 0;
+static int            stream_decoder_epoch = 0;
 
 /* Experimental Plan C path: bypass FFmpeg's v4l2_m2m wrapper and own
  * the stateful V4L2 decoder directly. Enabled only when
@@ -786,6 +793,103 @@
   return c;
 }
 
+static int open_v4l2m2m_decoder_context(int videoFormat, int width, int height,
+                                         const char *label) {
+  codec = (AVCodec *) find_v4l2m2m_decoder(videoFormat);
+  if (!codec)
+    return -1;
+
+  codec_ctx = avcodec_alloc_context3(codec);
+  if (!codec_ctx)
+    return -1;
+  codec_ctx->flags       |= AV_CODEC_FLAG_LOW_DELAY | AV_CODEC_FLAG_OUTPUT_CORRUPT;
+  codec_ctx->flags2      |= AV_CODEC_FLAG2_SHOW_ALL;
+  codec_ctx->thread_count = 1;
+  codec_ctx->width        = width;
+  codec_ctx->height       = height;
+  /* Critical: set pix_fmt to DRM_PRIME *before* avcodec_open2.
+   * The v4l2m2m wrapper reads avctx->pix_fmt at init time and copies
+   * it into capture->av_pix_fmt; only then does it offer DRM_PRIME
+   * via ff_get_format() during the eventual format negotiation. With
+   * AV_PIX_FMT_NONE here (the default), the wrapper bypasses
+   * get_format() entirely and emits the V4L2 native format (NV12 for
+   * iris), and our display thread starves waiting for frames it will
+   * never receive. */
+  codec_ctx->pix_fmt      = AV_PIX_FMT_DRM_PRIME;
+  codec_ctx->get_format   = get_drm_prime_fmt;
+  /* Attach an AV_HWDEVICE_TYPE_DRM device ctx so the v4l2m2m wrapper
+   * negotiates the V4L2 capture queue with V4L2_MEMORY_DMABUF + DRM
+   * PRIME export, and offers AV_PIX_FMT_DRM_PRIME via get_format().
+   * Without this, the wrapper falls back to NV12 software output and
+   * our zero-copy import path never sees a frame -- the display thread
+   * sleeps forever on disp_cond and the SDL window is never committed.
+   *
+   * Open the DRM render node (renderD128) rather than the primary node
+   * (card0) so we don't need DRM master; gamescope still owns
+   * master via the kiosk path. Render nodes are sufficient for the
+   * dma-buf import we need here. */
+  AVBufferRef *hw_dev = NULL;
+  if (av_hwdevice_ctx_create(&hw_dev, AV_HWDEVICE_TYPE_DRM,
+                             "/dev/dri/renderD128", NULL, 0) >= 0) {
+    codec_ctx->hw_device_ctx = av_buffer_ref(hw_dev);
+    av_buffer_unref(&hw_dev);
+    LOG("%s: attached AV_HWDEVICE_TYPE_DRM render node", label);
+  } else {
+    LOG("%s: av_hwdevice_ctx_create(DRM) failed -- v4l2m2m will"
+        " fall back to NV12 software output and our import path will not run", label);
+  }
+
+  if (avcodec_open2(codec_ctx, codec, NULL) < 0) {
+    LOG("%s: avcodec_open2 failed for %s", label, codec->name);
+    avcodec_free_context(&codec_ctx);
+    return -1;
+  }
+
+  return 0;
+}
+
+static int reopen_v4l2m2m_decoder_context(int width, int height, const char *reason) {
+  if (codec_ctx)
+    avcodec_free_context(&codec_ctx);
+  stream_decoder_epoch++;
+  return open_v4l2m2m_decoder_context(stream_video_format, width, height, reason);
+}
+
+static void drop_pending_display_frame(void) {
+  pthread_mutex_lock(&disp_mtx);
+  if (disp_pending) {
+    av_frame_free(&disp_pending);
+    disp_pending = NULL;
+    disp_pending_queued_us = 0;
+  }
+  pthread_mutex_unlock(&disp_mtx);
+}
+
+static int frame_visible_width(const AVFrame *frame) {
+  int cropped = frame->width - (int)frame->crop_left - (int)frame->crop_right;
+  return cropped > 0 ? cropped : frame->width;
+}
+
+static int frame_visible_height(const AVFrame *frame) {
+  int cropped = frame->height - (int)frame->crop_top - (int)frame->crop_bottom;
+  if (cropped > 0 && cropped != frame->height)
+    return cropped;
+
+  /* The iris v4l2m2m H.264 path can expose coded/aligned heights after a
+   * mid-stream SPS size change (1280x736 for a visible 1280x720 stream,
+   * 1920x1088 for 1920x1080). FFmpeg does not populate crop_bottom on
+   * those recovery frames, so crop the common 16:9 padding ourselves.
+   * Runtime resolution changes are validated to preserve the launch
+   * aspect ratio on the Sunshine side. */
+  int visible_16_9 = (frame->width * 9 + 8) / 16;
+  visible_16_9 &= ~1;
+  if (visible_16_9 > 0 && visible_16_9 < frame->height &&
+      frame->height - visible_16_9 <= 32)
+    return visible_16_9;
+
+  return frame->height;
+}
+
 /* ------------------------------------------------------------------ */
 /* GL setup (runs on the display thread)                              */
 /* ------------------------------------------------------------------ */
@@ -1434,14 +1538,17 @@
 
 static void draw_frame(AVFrame *frame) {
   static int draw_count = 0;
+  int visible_w = frame_visible_width(frame);
+  int visible_h = frame_visible_height(frame);
   if (++draw_count <= 3)
-    LOG("draw_frame: #%d size=%dx%d fmt=%s linesize=[%d,%d,%d,%d]",
-        draw_count, frame->width, frame->height,
+    LOG("draw_frame: #%d size=%dx%d visible=%dx%d crop=[%zu,%zu,%zu,%zu] fmt=%s linesize=[%d,%d,%d,%d]",
+        draw_count, frame->width, frame->height, visible_w, visible_h,
+        frame->crop_left, frame->crop_top, frame->crop_right, frame->crop_bottom,
         av_get_pix_fmt_name(frame->format),
         frame->linesize[0], frame->linesize[1],
         frame->linesize[2], frame->linesize[3]);
   pump_sdl_window_events();
-  update_render_geometry(frame->width, frame->height);
+  update_render_geometry(visible_w, visible_h);
   if (direct_dmabuf_present && direct_v4l2 && frame->format == AV_PIX_FMT_NV12) {
     draw_frame_direct_dmabuf(frame);
   } else if (frame->format == AV_PIX_FMT_DRM_PRIME) {
@@ -1488,9 +1595,16 @@
     return;
   }
 
+  SDL_Rect src_rect = {
+    .x = (int)frame->crop_left,
+    .y = (int)frame->crop_top,
+    .w = frame_visible_width(frame),
+    .h = frame_visible_height(frame),
+  };
+
   SDL_SetRenderDrawColor(sdl_renderer, 0, 0, 0, 255);
   SDL_RenderClear(sdl_renderer);
-  SDL_RenderCopy(sdl_renderer, sdl_nv12_texture, NULL, &sdl_dst_rect);
+  SDL_RenderCopy(sdl_renderer, sdl_nv12_texture, &src_rect, &sdl_dst_rect);
   SDL_RenderPresent(sdl_renderer);
 }
 static void draw_frame_drm_prime(AVFrame *frame) {
@@ -1636,61 +1750,22 @@
     if (direct_v4l2_setup(videoFormat, width, height) != 0)
       return -1;
   } else {
-  codec = (AVCodec *) find_v4l2m2m_decoder(videoFormat);
-  if (!codec)
-    return -1;
-
-  codec_ctx = avcodec_alloc_context3(codec);
-  if (!codec_ctx)
