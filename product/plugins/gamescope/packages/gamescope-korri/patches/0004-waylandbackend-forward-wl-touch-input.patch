From: Korri downstream <maintainers@korri.invalid>
Date: Mon, 20 Jul 2026 00:00:00 +0000
Subject: [PATCH] WaylandBackend: forward wl_touch input to nested clients

The nested Wayland backend binds wl_seat v8 but never calls
wl_seat.get_touch: CWaylandInputThread declares wl_touch *m_pTouch and
leaves it unbound, so touchscreen events delivered by the host compositor
(Sway) to the gamescope toplevel are silently dropped. Games and UIs inside
nested gamescope (Steam on Korri kiosks) never see touch at all, while the
SDL backend forwards SDL_FINGER* events normally. Upstream tracks this as
ValveSoftware/gamescope#1606.

Bind wl_touch from the seat-capabilities handler on the input thread and
forward down/up/motion through the existing wlserver touch path
(wlserver_touchdown/up/motion), reusing the pointer handlers' plane-state
coordinate transform (fractional scale + plane destination offset ->
normalized output coordinates). Touch IDs held down are tracked so
wl_touch.cancel lifts every active point instead of leaving wlserver with
stuck touches, and events for surfaces that are not the gamescope toplevel
are ignored. Touch click-mode semantics (--default-touch-mode) are applied
by wlserver, matching the SDL backend behaviour.
---
 src/Backends/WaylandBackend.cpp | 113 insertions

--- a/src/Backends/WaylandBackend.cpp
+++ b/src/Backends/WaylandBackend.cpp
@@ -564,6 +564,9 @@
         std::atomic<std::shared_ptr<zwp_relative_pointer_v1>> m_pRelativePointer = nullptr;
         std::unordered_set<uint32_t> m_uScancodesHeld;
 
+        wl_surface *m_pCurrentTouchSurface = nullptr;
+        std::unordered_set<int32_t> m_nTouchIdsDown;
+
         void Wayland_Registry_Global( wl_registry *pRegistry, uint32_t uName, const char *pInterface, uint32_t uVersion );
         static const wl_registry_listener s_RegistryListener;
 
@@ -591,6 +594,15 @@
         void Wayland_Keyboard_RepeatInfo( wl_keyboard *pKeyboard, int32_t nRate, int32_t nDelay );
         static const wl_keyboard_listener s_KeyboardListener;
 
+        std::optional<glm::dvec2> TouchToOutputCoords( wl_surface *pSurface, wl_fixed_t fSurfaceX, wl_fixed_t fSurfaceY );
+
+        void Wayland_Touch_Down( wl_touch *pTouch, uint32_t uSerial, uint32_t uTime, wl_surface *pSurface, int32_t nTouchId, wl_fixed_t fSurfaceX, wl_fixed_t fSurfaceY );
+        void Wayland_Touch_Up( wl_touch *pTouch, uint32_t uSerial, uint32_t uTime, int32_t nTouchId );
+        void Wayland_Touch_Motion( wl_touch *pTouch, uint32_t uTime, int32_t nTouchId, wl_fixed_t fSurfaceX, wl_fixed_t fSurfaceY );
+        void Wayland_Touch_Frame( wl_touch *pTouch );
+        void Wayland_Touch_Cancel( wl_touch *pTouch );
+        static const wl_touch_listener s_TouchListener;
+
 	    void Wayland_RelativePointer_RelativeMotion( zwp_relative_pointer_v1 *pRelativePointer, uint32_t uTimeHi, uint32_t uTimeLo, wl_fixed_t fDx, wl_fixed_t fDy, wl_fixed_t fDxUnaccel, wl_fixed_t fDyUnaccel );
         static const zwp_relative_pointer_v1_listener s_RelativePointerListener;
     };
@@ -626,6 +638,16 @@
         .modifiers     = WAYLAND_USERDATA_TO_THIS( CWaylandInputThread, Wayland_Keyboard_Modifiers ),
         .repeat_info   = WAYLAND_USERDATA_TO_THIS( CWaylandInputThread, Wayland_Keyboard_RepeatInfo ),
     };
+    const wl_touch_listener CWaylandInputThread::s_TouchListener =
+    {
+        .down        = WAYLAND_USERDATA_TO_THIS( CWaylandInputThread, Wayland_Touch_Down ),
+        .up          = WAYLAND_USERDATA_TO_THIS( CWaylandInputThread, Wayland_Touch_Up ),
+        .motion      = WAYLAND_USERDATA_TO_THIS( CWaylandInputThread, Wayland_Touch_Motion ),
+        .frame       = WAYLAND_USERDATA_TO_THIS( CWaylandInputThread, Wayland_Touch_Frame ),
+        .cancel      = WAYLAND_USERDATA_TO_THIS( CWaylandInputThread, Wayland_Touch_Cancel ),
+        .shape       = WAYLAND_NULL(),
+        .orientation = WAYLAND_NULL(),
+    };
     const zwp_relative_pointer_v1_listener CWaylandInputThread::s_RelativePointerListener =
     {
         .relative_motion = WAYLAND_USERDATA_TO_THIS( CWaylandInputThread, Wayland_RelativePointer_RelativeMotion ),
@@ -3027,6 +3049,20 @@
                 wl_keyboard_add_listener( m_pKeyboard, &s_KeyboardListener, this );
             }
         }
+
+        if ( !!( uCapabilities & WL_SEAT_CAPABILITY_TOUCH ) != !!m_pTouch )
+        {
+            if ( m_pTouch )
+            {
+                wl_touch_release( m_pTouch );
+                m_pTouch = nullptr;
+            }
+            else
+            {
+                m_pTouch = wl_seat_get_touch( m_pSeat );
+                wl_touch_add_listener( m_pTouch, &s_TouchListener, this );
+            }
+        }
     }
 
     void CWaylandInputThread::Wayland_Seat_Name( wl_seat *pSeat, const char *pName )
@@ -3242,6 +3278,83 @@
 
     // Relative Pointer
 
+    std::optional<glm::dvec2> CWaylandInputThread::TouchToOutputCoords( wl_surface *pSurface, wl_fixed_t fSurfaceX, wl_fixed_t fSurfaceY )
+    {
+        if ( !pSurface )
+            return std::nullopt;
+
+        CWaylandPlane *pPlane = (CWaylandPlane *)wl_surface_get_user_data( pSurface );
+        if ( !pPlane )
+            return std::nullopt;
+
+        auto oState = pPlane->GetCurrentState();
+        if ( !oState )
+            return std::nullopt;
+
+        uint32_t uScale = oState->uFractionalScale;
+
+        double flX = ( wl_fixed_to_double( fSurfaceX ) * uScale / 120.0 + oState->nDestX ) / g_nOutputWidth;
+        double flY = ( wl_fixed_to_double( fSurfaceY ) * uScale / 120.0 + oState->nDestY ) / g_nOutputHeight;
+        return glm::dvec2{ flX, flY };
+    }
+    void CWaylandInputThread::Wayland_Touch_Down( wl_touch *pTouch, uint32_t uSerial, uint32_t uTime, wl_surface *pSurface, int32_t nTouchId, wl_fixed_t fSurfaceX, wl_fixed_t fSurfaceY )
+    {
+        if ( !IsGamescopeToplevel( pSurface ) )
+            return;
+
+        m_pCurrentTouchSurface = pSurface;
+
+        std::optional<glm::dvec2> oCoords = TouchToOutputCoords( pSurface, fSurfaceX, fSurfaceY );
+        if ( !oCoords )
+            return;
+
+        m_nTouchIdsDown.insert( nTouchId );
+
+        wlserver_lock();
+        wlserver_touchdown( oCoords->x, oCoords->y, nTouchId, ++m_uFakeTimestamp );
+        wlserver_unlock();
+    }
+    void CWaylandInputThread::Wayland_Touch_Up( wl_touch *pTouch, uint32_t uSerial, uint32_t uTime, int32_t nTouchId )
+    {
+        if ( !m_nTouchIdsDown.erase( nTouchId ) )
+            return;
+
+        if ( m_nTouchIdsDown.empty() )
+            m_pCurrentTouchSurface = nullptr;
+
+        wlserver_lock();
+        wlserver_touchup( nTouchId, ++m_uFakeTimestamp );
+        wlserver_unlock();
+    }
+    void CWaylandInputThread::Wayland_Touch_Motion( wl_touch *pTouch, uint32_t uTime, int32_t nTouchId, wl_fixed_t fSurfaceX, wl_fixed_t fSurfaceY )
+    {
+        if ( !m_nTouchIdsDown.contains( nTouchId ) )
+            return;
+
+        std::optional<glm::dvec2> oCoords = TouchToOutputCoords( m_pCurrentTouchSurface, fSurfaceX, fSurfaceY );
+        if ( !oCoords )
+            return;
+
+        wlserver_lock();
+        wlserver_touchmotion( oCoords->x, oCoords->y, nTouchId, ++m_uFakeTimestamp );
+        wlserver_unlock();
+    }
+    void CWaylandInputThread::Wayland_Touch_Frame( wl_touch *pTouch )
+    {
+    }
+    void CWaylandInputThread::Wayland_Touch_Cancel( wl_touch *pTouch )
+    {
+        if ( m_nTouchIdsDown.empty() )
+            return;
+
+        wlserver_lock();
+        for ( int32_t nTouchId : m_nTouchIdsDown )
+            wlserver_touchup( nTouchId, ++m_uFakeTimestamp );
+        wlserver_unlock();
+
+        m_nTouchIdsDown.clear();
+        m_pCurrentTouchSurface = nullptr;
+    }
     void CWaylandInputThread::Wayland_RelativePointer_RelativeMotion( zwp_relative_pointer_v1 *pRelativePointer, uint32_t uTimeHi, uint32_t uTimeLo, wl_fixed_t fDx, wl_fixed_t fDy, wl_fixed_t fDxUnaccel, wl_fixed_t fDyUnaccel )
     {
 		// Don't do any motion/movement stuff if we don't have kb focus
