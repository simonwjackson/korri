+
+/* Accept a known visible dimension as the crop target when the decoder's
+ * coded dimension only exceeds it by hardware alignment padding. Venus/iris
+ * aligns coded width to 128 and coded height to 32. */
+static int visible_from_hint(int coded, int hint, int max_pad) {
+  return (hint > 0 && hint <= coded && coded - hint <= max_pad) ? hint : 0;
+}
