+  json_object_object_get_ex(params, "y", &raw_y);
+  json_object_object_get_ex(params, "w", &raw_w);
+  json_object_object_get_ex(params, "h", &raw_h);
+  if (raw_x == NULL || raw_y == NULL || raw_w == NULL || raw_h == NULL
+      || json_object_get_type(raw_x) != json_type_int || json_object_get_type(raw_y) != json_type_int
+      || json_object_get_type(raw_w) != json_type_int || json_object_get_type(raw_h) != json_type_int) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32602, "invalid touch bounds", "invalid"));
+    return 0;
+  }
+
+  int x = json_object_get_int(raw_x);
+  int y = json_object_get_int(raw_y);
+  int w = json_object_get_int(raw_w);
+  int h = json_object_get_int(raw_h);
+  if (x < MOONLIGHT_CONTROL_MIN_TOUCH_BOUNDS_X || x > MOONLIGHT_CONTROL_MAX_TOUCH_BOUNDS_X
+      || y < MOONLIGHT_CONTROL_MIN_TOUCH_BOUNDS_Y || y > MOONLIGHT_CONTROL_MAX_TOUCH_BOUNDS_Y
+      || w < MOONLIGHT_CONTROL_MIN_TOUCH_BOUNDS_W || w > MOONLIGHT_CONTROL_MAX_TOUCH_BOUNDS_W
+      || h < MOONLIGHT_CONTROL_MIN_TOUCH_BOUNDS_H || h > MOONLIGHT_CONTROL_MAX_TOUCH_BOUNDS_H) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32602, "touch bounds out of bounds", "invalid"));
+    return 0;
+  }
+
+  pthread_mutex_lock(&control.lock);
+  int controller = strcmp(control.authority, "controller") == 0;
+  pthread_mutex_unlock(&control.lock);
+  if (!controller) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32000, "command authority required", "unauthorized"));
+    return 0;
+  }
+
+  if (!evdev_set_absolute_touch_bounds(x, y, w, h)) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32000, "absolute touch disabled", "disabled"));
+    return 0;
+  }
+
+  uint32_t command_id = moonlight_local_control_next_command_id();
+  pthread_mutex_lock(&control.lock);
+  uint64_t seq = ++control.seq;
+  control.has_last_input_command = 1;
+  control.last_input_request_id = command_id;
+  snprintf(control.last_input_command, sizeof(control.last_input_command), "%s", method_name);
+  snprintf(control.last_input_status, sizeof(control.last_input_status), "%s", "applied");
+  control.moonlight_local_control_event_history[seq % MOONLIGHT_CONTROL_EVENT_HISTORY].seq = seq;
+  snprintf(control.moonlight_local_control_event_history[seq % MOONLIGHT_CONTROL_EVENT_HISTORY].name, sizeof(control.moonlight_local_control_event_history[0].name), "%s", "input.commandResult");
+  pthread_mutex_unlock(&control.lock);
+
+  struct json_object* result = json_object_new_object();
+  json_object_object_add(result, "_tag", json_object_new_string("input.command.result"));
+  json_object_object_add(result, "requestId", json_object_new_int64((int64_t) command_id));
+  json_object_object_add(result, "command", json_object_new_string(method_name));
+  json_object_object_add(result, "status", json_object_new_string("applied"));
+  moonlight_local_control_write_json(client_fd, moonlight_local_control_success(id, result));
+  moonlight_local_control_emit_event(moonlight_local_control_input_command_event(seq, command_id, method_name, "applied"));
+  return 1;
+}
+
