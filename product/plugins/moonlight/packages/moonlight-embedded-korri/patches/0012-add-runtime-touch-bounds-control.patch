+static struct json_object* moonlight_local_control_input_command_event(uint64_t seq, uint32_t request_id, const char* command, const char* status) {
+  struct json_object* event = json_object_new_object();
+  json_object_object_add(event, "jsonrpc", json_object_new_string("2.0"));
+  json_object_object_add(event, "method", json_object_new_string("moonlight.event"));
+  struct json_object* params = json_object_new_object();
+  json_object_object_add(params, "seq", json_object_new_int64((int64_t) seq));
+  json_object_object_add(params, "monotonicMs", json_object_new_int64((int64_t) moonlight_local_control_monotonic_ms()));
+  struct json_object* payload = json_object_new_object();
+  json_object_object_add(payload, "name", json_object_new_string("input.commandResult"));
+  json_object_object_add(payload, "requestId", json_object_new_int64((int64_t) request_id));
+  json_object_object_add(payload, "command", json_object_new_string(command));
+  json_object_object_add(payload, "status", json_object_new_string(status));
+  json_object_object_add(params, "event", payload);
+  json_object_object_add(event, "params", params);
+  return event;
