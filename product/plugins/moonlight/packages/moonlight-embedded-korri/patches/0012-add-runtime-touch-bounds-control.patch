+    return 0;
+  }
+
+  struct json_object* params = NULL;
+  json_object_object_get_ex(request, "params", &params);
+  if (params == NULL || json_object_get_type(params) != json_type_object) {
+    moonlight_local_control_write_json(client_fd, moonlight_local_control_error(id, -32602, "missing params", "invalid"));
+    return 0;
+  }
