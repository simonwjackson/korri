+static struct json_object* moonlight_local_control_health_sample_locked(void) {
+  struct json_object* sample = json_object_new_object();
+  json_object_object_add(sample, "seq", json_object_new_int64((int64_t) control.health_sample_seq));
+  json_object_object_add(sample, "sampledAtMs", json_object_new_int64((int64_t) control.health_sampled_at_ms));
+  json_object_object_add(sample, "rttMs", json_object_new_int((int) control.health_rtt_ms));
+  json_object_object_add(sample, "rttVarianceMs", json_object_new_int((int) control.health_rtt_variance_ms));
+  json_object_object_add(sample, "lossFraction", json_object_new_double(control.health_loss_fraction));
+  json_object_object_add(sample, "deliveredBitrateKbps", json_object_new_int((int) control.health_delivered_bitrate_kbps));
+  json_object_object_add(sample, "requestedBitrateKbps", json_object_new_int(control.bitrate_kbps));
+  json_object_object_add(sample, "deliveredFps", json_object_new_int((int) control.health_delivered_fps));
+  json_object_object_add(sample, "requestedFps", json_object_new_int(control.fps));
+  json_object_object_add(sample, "framesDropped", json_object_new_int((int) control.health_last_frames_dropped));
+  json_object_object_add(sample, "decodeTimeMs", json_object_new_int((int) control.health_last_decode_time_ms));
+  json_object_object_add(sample, "queueDepth", json_object_new_int((int) control.health_display_queue_depth));
+  if (control.health_first_frame_ms > 0)
+    json_object_object_add(sample, "firstFrameMs", json_object_new_int((int) control.health_first_frame_ms));
+  return sample;
+}
