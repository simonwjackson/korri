+void moonlight_local_control_update_connection_status(const char* connection) {
+  if (connection == NULL)
+    return;
+
+  struct json_object* event = NULL;
+  pthread_mutex_lock(&control.lock);
+  if (control.enabled) {
+    snprintf(control.connection, sizeof(control.connection), "%s", connection);
+    control.seq++;
+    control.moonlight_local_control_event_history[control.seq % MOONLIGHT_CONTROL_EVENT_HISTORY].seq = control.seq;
+    snprintf(control.moonlight_local_control_event_history[control.seq % MOONLIGHT_CONTROL_EVENT_HISTORY].name, sizeof(control.moonlight_local_control_event_history[0].name), "%s", "quality.connection");
+    event = moonlight_local_control_event_locked("quality.connection");
+    struct json_object* params = NULL;
+    struct json_object* payload = NULL;
+    if (json_object_object_get_ex(event, "params", &params)
+        && json_object_object_get_ex(params, "event", &payload)) {
+      json_object_object_add(payload, "connection", json_object_new_string(control.connection));
+    }
+  }
+  pthread_mutex_unlock(&control.lock);
+
+  if (event != NULL)
+    moonlight_local_control_emit_event(event);
+}
+
+void moonlight_local_control_record_video_decode(uint32_t encoded_bytes, uint32_t decoded_frames, uint32_t dropped_frames, uint32_t decode_time_ms, uint32_t queue_depth, uint32_t first_frame_ms) {
+  pthread_mutex_lock(&control.lock);
+  if (control.enabled) {
+    control.health_video_bytes_since_sample += encoded_bytes;
+    control.health_video_frames_since_sample += decoded_frames;
+    control.health_video_dropped_since_sample += dropped_frames;
+    if (decoded_frames > 0) {
+      control.health_decode_time_total_ms += decode_time_ms;
+      control.health_decode_time_samples += 1;
+    }
+    control.health_display_queue_depth = queue_depth;
+    if (first_frame_ms > 0)
+      control.health_first_frame_ms = first_frame_ms;
+  }
+  pthread_mutex_unlock(&control.lock);
+}
