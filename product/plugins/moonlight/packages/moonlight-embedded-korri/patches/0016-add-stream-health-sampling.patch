+static void moonlight_local_control_maybe_emit_health_sample(void) {
+  uint64_t now = moonlight_local_control_monotonic_ms();
+  uint32_t rtt = 0;
+  uint32_t rtt_var = 0;
+  (void) LiGetEstimatedRttInfo(&rtt, &rtt_var);
+  const RTP_VIDEO_STATS* video_stats = LiGetRTPVideoStats();
+
+  struct json_object* event = NULL;
+  pthread_mutex_lock(&control.lock);
+  if (!control.enabled || !control.running || now == 0 || (control.health_last_emit_at_ms != 0 && now - control.health_last_emit_at_ms < MOONLIGHT_CONTROL_HEALTH_SAMPLE_INTERVAL_MS)) {
+    pthread_mutex_unlock(&control.lock);
+    return;
+  }
+
+  uint64_t elapsed_ms = control.health_last_emit_at_ms == 0 ? MOONLIGHT_CONTROL_HEALTH_SAMPLE_INTERVAL_MS : now - control.health_last_emit_at_ms;
+  uint32_t video_packets = video_stats == NULL ? control.health_last_video_packets : video_stats->packetCountVideo;
+  uint32_t video_losses = video_stats == NULL ? control.health_last_video_losses : (video_stats->packetCountFecFailed + video_stats->packetCountOOS + video_stats->packetCountInvalid + video_stats->packetCountFecInvalid);
+  uint32_t packet_delta = video_packets >= control.health_last_video_packets ? video_packets - control.health_last_video_packets : 0;
+  uint32_t loss_delta = video_losses >= control.health_last_video_losses ? video_losses - control.health_last_video_losses : 0;
+
+  control.health_sample_seq++;
+  control.health_sampled_at_ms = now;
+  control.health_last_emit_at_ms = now;
+  control.health_rtt_ms = rtt;
+  control.health_rtt_variance_ms = rtt_var;
+  control.health_loss_fraction = packet_delta == 0 ? 0.0 : (double) loss_delta / (double) packet_delta;
+  if (control.health_loss_fraction > 1.0)
+    control.health_loss_fraction = 1.0;
+  control.health_last_frames_dropped = control.health_video_dropped_since_sample;
+  control.health_last_decode_time_ms = control.health_decode_time_samples == 0 ? 0 : control.health_decode_time_total_ms / control.health_decode_time_samples;
+  control.health_last_video_packets = video_packets;
+  control.health_last_video_losses = video_losses;
+  if (elapsed_ms > 0) {
+    control.health_delivered_bitrate_kbps = (uint32_t) ((control.health_video_bytes_since_sample * 8u) / elapsed_ms);
+    control.health_delivered_fps = (uint32_t) ((control.health_video_frames_since_sample * 1000u) / elapsed_ms);
+  }
+  control.has_health_sample = 1;
+  control.seq++;
+  control.moonlight_local_control_event_history[control.seq % MOONLIGHT_CONTROL_EVENT_HISTORY].seq = control.seq;
+  snprintf(control.moonlight_local_control_event_history[control.seq % MOONLIGHT_CONTROL_EVENT_HISTORY].name, sizeof(control.moonlight_local_control_event_history[0].name), "%s", "quality.sample");
+
+  event = moonlight_local_control_event_locked("quality.sample");
+  struct json_object* params = NULL;
+  struct json_object* payload = NULL;
+  if (json_object_object_get_ex(event, "params", &params)
+      && json_object_object_get_ex(params, "event", &payload)) {
+    json_object_object_add(payload, "sample", moonlight_local_control_health_sample_locked());
+  }
+
+  control.health_video_bytes_since_sample = 0;
+  control.health_video_frames_since_sample = 0;
+  control.health_video_dropped_since_sample = 0;
+  control.health_decode_time_total_ms = 0;
+  control.health_decode_time_samples = 0;
+  pthread_mutex_unlock(&control.lock);
+
+  if (event != NULL)
+    moonlight_local_control_emit_event(event);
+}
