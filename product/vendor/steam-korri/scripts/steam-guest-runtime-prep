#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: steam-guest-runtime-prep [--check|--apply|--patch-proton]

Repair mutable Steam Runtime / pressure-vessel state in a caller-provided
ARM64 Steam home. This helper is package-owned runtime mechanics only: it does
not choose guest paths, start system services, or launch a display session.

Required environment:
  STEAM_HOME        Steam client home containing steamapps/common

Modes:
  --check          Validate required environment only
  --apply          Repair mutable runtime state (default)
  --patch-proton   Repair Proton ARM64 payloads/FEX links only
EOF
}

mode=apply
case "${1:-}" in
  ""|--apply) mode=apply ;;
  --check) mode=check ;;
  --patch-proton) mode=patch-proton ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

if [ -z "${STEAM_HOME:-}" ]; then
  echo "error: STEAM_HOME must be set explicitly" >&2
  exit 2
fi

if [ "$mode" = check ]; then
  echo "steam-guest-runtime-prep mode=check"
  echo "STEAM_HOME=$STEAM_HOME"
  exit 0
fi

common="$STEAM_HOME/steamapps/common"
[ -d "$common" ] || exit 0

# Native ARM64 Steam starts this helper by basename. Expose the ARM64 runtime
# copy in steamrtarm64/bin, which steam-guest-run prepends to PATH, when Valve's
# payload contains it. Without this, Steam disables the runtime launcher service
# and Proton's lsteamclient cannot initialize reliably for Windows games.
launcher_service="$STEAM_HOME/steam-runtime-steamrt-arm64/bin/steam-runtime-launcher-service"
if [ -x "$launcher_service" ]; then
  install -d -m 0755 "$STEAM_HOME/steamrtarm64/bin"
  ln -sfn "$launcher_service" "$STEAM_HOME/steamrtarm64/bin/steam-runtime-launcher-service"
fi

is_fex_wrapper() {
  local file="$1" first_line
  [ -f "$file" ] || return 1

  # Only Korri's shell trampolines are FEX wrappers. Do not grep arbitrary ELF
  # payloads: freshly downloaded pressure-vessel binaries can contain strings
  # that mention FEX and must still be wrapped for the ARM64 Steam client.
  IFS= read -r first_line < "$file" || return 1
  case "$first_line" in
    '#!'*) ;;
    *) return 1 ;;
  esac

  grep -q "FEX_ROOTFS\|/FEX\|exec FEX" "$file" 2>/dev/null
}

restore_fex_wrapper() {
  local file="$1" candidate depth limit
  [ -f "$file" ] || return 0
  is_fex_wrapper "$file" || return 0

  # Runtime prep may be re-run after an interrupted/live repair. Collapse any
  # stacked wrapper backups (tool, tool.x86_64, tool.x86_64.x86_64, ...) back to
  # the deepest non-wrapper executable so FEX is never nested under itself.
  # Old live experiments can leave very deep all-wrapper chains; cap the scan so
  # routine Steam startup does not spend minutes walking stale backups.
  candidate="$file.x86_64"
  depth=0
  limit="${KORRI_RUNTIME_PREP_BACKUP_SCAN_LIMIT:-16}"
  while [ -f "$candidate" ]; do
    if ! is_fex_wrapper "$candidate"; then
      mv -f "$candidate" "$file"
      chmod a+rx "$file" 2>/dev/null || true
      return 0
    fi
    depth=$((depth + 1))
    if [ "$depth" -ge "$limit" ]; then
      return 0
    fi
    candidate="$candidate.x86_64"
  done

  candidate="$file.x86"
  if [ -f "$candidate" ] && ! is_fex_wrapper "$candidate"; then
    mv -f "$candidate" "$file"
    chmod a+rx "$file" 2>/dev/null || true
    return 0
  fi

  if [ "${KORRI_RUNTIME_PREP_VERBOSE:-0}" = 1 ]; then
    echo "steam-guest-runtime-prep: warning: no non-FEX backup found for $file; tool left as FEX wrapper" >&2
  fi
}

fex_bin="${FEX_BIN:-$(command -v FEX 2>/dev/null || true)}"
if [ -z "$fex_bin" ] && [ -x /run/current-system/sw/bin/FEX ]; then
  fex_bin=/run/current-system/sw/bin/FEX
fi
if [ -z "$fex_bin" ]; then
  fex_bin=FEX
fi

# Runtime prep can run either inside the Steam FHS capsule or as a systemd
# repair service outside it. Pressure-vessel helper trampolines execute later
# inside the FHS/runtime container, so let product policy override the path
# embedded in those trampolines without losing the real host FEX path used for
# resource discovery.
fex_wrapper_bin="${FEX_WRAPPER_BIN:-$fex_bin}"

fex_share="${FEX_SHARE:-}"
if [ -z "$fex_share" ]; then
  case "$fex_bin" in
    */bin/FEX) fex_share="${fex_bin%/bin/FEX}/share/fex-emu" ;;
  esac
fi
if [ -n "$fex_share" ] && [ -d "$fex_share" ]; then
  for proton in "$common"/Proton*; do
    [ -d "$proton/files/share" ] || continue
    target="$proton/files/share/fex-emu"
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      mv -f "$target" "$target.pre-korri-fex-share"
    fi
    ln -sfn "$fex_share" "$target"
  done
fi

wrap_fex_tool() {
  local file="$1" backup info
  [ -f "$file" ] || return 0
  case "${file##*/}" in
    srt-bwrap)
      backup="$file.x86_64"
      if [ ! -e "$backup" ]; then
        mv -f "$file" "$backup"
      fi
      cat > "$file" <<'EOF'
#!/bin/sh
exec bwrap "$@"
EOF
      chmod 755 "$file"
      return 0
      ;;
  esac

  restore_fex_wrapper "$file"

  if is_fex_wrapper "$file"; then
    return 0
  fi

  info="$(file "$file" 2>/dev/null || true)"
  case "$info" in
    *"shared object"*)
      return 0
      ;;
    *"executable"*"x86-64"*|*"x86-64"*"executable"*|*"executable"*"Intel 80386"*|*"Intel 80386"*"executable"*)
      backup="$file.x86_64"
      if [ ! -e "$backup" ]; then
        mv -f "$file" "$backup"
      fi
      cat > "$file" <<EOF
#!/usr/bin/env bash
set -euo pipefail
: "\${FEX_ROOTFS:?FEX_ROOTFS must be set by the guest adapter before running wrapped Steam Runtime helpers}"
PATH="/usr/bin:/bin:/usr/sbin:/sbin:\${PATH:-}"
export FEX_ROOTFS PATH

# KORRI_STEAM_OVERLAY_FILTER: Steam Deck UI can inject
# gameoverlayrenderer.so into pressure-vessel launches even when the managed
# client is only being used as an AppID broker. On the SM8550 kiosk path those
# renderer surfaces can bleed through or flash over the real game. Filter only
# overlay preload arguments before entering the x86_64 helper; preserve argv
# exactly with a bash array so paths such as "Proton 10.0" remain separate.
if [ "\${KORRI_STEAM_DISABLE_OVERLAY:-1}" = 1 ]; then
  filtered_args=()
  before_command=1
  for arg in "\$@"; do
    if [ "\$before_command" = 1 ]; then
      if [ "\$arg" = "--" ]; then
        before_command=0
        filtered_args+=("\$arg")
        continue
      fi
      case "\$arg" in
        *gameoverlayrenderer.so*) continue ;;
      esac
    fi
    filtered_args+=("\$arg")
  done
  exec $fex_wrapper_bin "\$0.x86_64" "\${filtered_args[@]}"
fi

exec $fex_wrapper_bin "\$0.x86_64" "\$@"
EOF
      chmod 755 "$file"
      ;;
  esac
}

# Earlier live experiments wrapped Proton/Wine payloads themselves. That breaks
# Wine's own ELF-header checks. Keep Proton intact and restore any wrappers from
# backups left by experiments; wrap only Steam Runtime / pressure-vessel Linux
# helper executables launched by the ARM64 Steam client.
for dir in "$common"/Proton*/files/bin "$common"/Proton*/files/bin-wow64 "$common"/Proton*/files/lib/wine/*-unix; do
  [ -d "$dir" ] || continue
  find "$dir" -maxdepth 1 -type f ! -name '*.x86_64*' ! -name '*.x86' | while IFS= read -r file; do
    restore_fex_wrapper "$file"
  done
done

if [ "$mode" != patch-proton ]; then
for pv in "$common"/SteamLinuxRuntime*/pressure-vessel "$STEAM_HOME"/steamrt64/pv-runtime/steam-runtime-steamrt/pressure-vessel; do
  [ -d "$pv" ] || continue
  find "$pv" -type f -perm -0100 ! -name '*.x86_64*' ! -name '*.x86' | while IFS= read -r file; do
    wrap_fex_tool "$file"
  done
done

# Some ARM64 runtime snapshots lack .uuid marker files in font directories,
# which makes pressure-vessel abort before Proton starts.
for fonts in "$common"/SteamLinuxRuntime*/steamrt*_platform_*/files/share/fonts "$common"/SteamLinuxRuntime*/sniper_platform_*/files/share/fonts; do
  [ -d "$fonts" ] || continue
  find "$fonts" -type d | while IFS= read -r dir; do
    : > "$dir/.uuid"
  done
done
fi


patch_proton_arm64() {
  local proton="$1" python
  [ -f "$proton" ] || return 0

  python="$(command -v python3 2>/dev/null || true)"
  if [ -z "$python" ]; then
    echo "steam-guest-runtime-prep: warning: python3 unavailable; cannot patch $proton" >&2
    return 0
  fi

  "$python" - "$proton" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
try:
    text = path.read_text()
except UnicodeDecodeError:
    text = path.read_text(errors="surrogateescape")
original = text

config_anchor = '''        if "PROTON_LOG" in self.env:\n            app_config["Config"]["SilentLog"] = "0" if self.log_enabled_for("fex", True) else "1"\n\n        return app_config\n'''
config_patch = '''        if "PROTON_LOG" in self.env:\n            app_config["Config"]["SilentLog"] = "0" if self.log_enabled_for("fex", True) else "1"\n\n        # KORRI_FEX_CONFIG_MERGE_PATCH: Steam does not currently pass the\n        # FEX performance flags for this copied ARM64 compatibility tool.\n        # If Proton generated an otherwise empty per-app config, inherit the\n        # ROCKNIX-like global FEX config seeded by Korri.\n        if not app_config["Config"] and not app_config["ThunksDB"]:\n            try:\n                global_fex_config_path = os.environ.get("KORRI_FEX_CONFIG") or "/home/korri/.config/fex-emu/Config.json"\n                with open(global_fex_config_path, "r") as global_fex_config_file:\n                    global_fex_config = json.load(global_fex_config_file)\n                app_config["Config"].update(global_fex_config.get("Config", {}))\n                app_config["ThunksDB"].update(global_fex_config.get("ThunksDB", {}))\n            except Exception as e:\n                self.log_file.write("Korri: failed to merge global FEX config: " + str(e) + "\\n")\n\n        return app_config\n'''
if "KORRI_FEX_CONFIG_MERGE_PATCH" not in text:
    if config_anchor not in text:
        raise SystemExit(f"{path}: could not find FEX config anchor")
    text = text.replace(config_anchor, config_patch, 1)

wrap_method = '''\n    def korri_fex_wrap_args(self, args):\n        # KORRI_FEX_LAUNCHER_PATCH: Proton 11 ARM64 compatibility tool uses\n        # an x86_64 Wine payload. Keep Wine files as ELF for Proton checks,\n        # but enter FEX at subprocess boundaries on aarch64.\n        if platform.machine() != "aarch64" or len(args) == 0:\n            return args\n        fex = os.environ.get("PROTON_FEX_BIN") or shutil.which("FEX") or "FEX"\n        first = args[0]\n        if first == fex:\n            return args\n        if isinstance(first, str) and first.startswith(g_proton.path("files/")):\n            return [fex] + args\n        return args\n'''
if "KORRI_FEX_LAUNCHER_PATCH" not in text:
    run_proc_anchor = '''\n    def run_proc(self, args, local_env=None):\n'''
    if run_proc_anchor not in text:
        raise SystemExit(f"{path}: could not find run_proc anchor")
    text = text.replace(run_proc_anchor, wrap_method + run_proc_anchor, 1)
    call_anchor = '''        return subprocess.call(args, env=local_env, stderr=self.log_file, stdout=self.log_file)\n'''
    call_patch = '''        return subprocess.call(self.korri_fex_wrap_args(args), env=local_env, stderr=self.log_file, stdout=self.log_file)\n'''
    if call_anchor not in text:
        raise SystemExit(f"{path}: could not find subprocess.call anchor")
    text = text.replace(call_anchor, call_patch, 1)
    argv_anchor = '''\n        rc = self.run_proc(adverb + argv + sys.argv[2:] + self.cmdlineappend)\n'''
    argv_patch = '''\n        if platform.machine() == "aarch64" and g_proton.host_pe_arch == "x86_64-windows":\n            argv = self.korri_fex_wrap_args(argv)\n\n        rc = self.run_proc(adverb + argv + sys.argv[2:] + self.cmdlineappend)\n'''
    if argv_anchor not in text:
        raise SystemExit(f"{path}: could not find argv wrap anchor")
    text = text.replace(argv_anchor, argv_patch, 1)

if "KORRI_30XX_DIRECT_EXE_PATCH" not in text:
    cod_anchor = '''        # CoD: Black Ops 3 workaround\n        if os.environ.get("SteamGameId", 0) in [\n'''
    cod_patch = '''        # KORRI_30XX_DIRECT_EXE_PATCH: on SM8550/FEX, Proton's x86 Steam shim\n        # can stay alive without handing off to 30XX. Launch this app exe directly.\n        if platform.machine() == "aarch64" and os.environ.get("SteamGameId", 0) == "1029210":\n            argv = [g_proton.wine_bin] + sys.argv[2:]\n        # CoD: Black Ops 3 workaround\n        elif os.environ.get("SteamGameId", 0) in [\n'''
    if cod_anchor not in text:
        raise SystemExit(f"{path}: could not find 30XX direct-exe anchor")
    text = text.replace(cod_anchor, cod_patch, 1)

if text != original:
    backup = path.with_name(path.name + ".pre-korri-patch")
    if not backup.exists():
        backup.write_text(original)
    path.write_text(text)
PY
}

# Proton and Steam Runtime helper scripts commonly use /usr/bin/env python3.
# Nested pressure-vessel containers have sparse PATH, so use the FHS-visible
# absolute interpreter from the FHS runtime.
for proton in "$common"/Proton*/proton; do
  [ -f "$proton" ] || continue
  first_line="$(head -n 1 "$proton" 2>/dev/null || true)"
  if [ "$first_line" = "#!/usr/bin/env python3" ]; then
    tmp="$proton.rocknix-python3-tmp"
    { echo '#!/usr/bin/python3'; sed '1d' "$proton"; } > "$tmp"
    chmod --reference="$proton" "$tmp" 2>/dev/null || chmod a+rx "$tmp"
    mv -f "$tmp" "$proton"
  fi
  case "$proton" in
    *"(ARM64)"*)
      patch_proton_arm64 "$proton" || echo "steam-guest-runtime-prep: warning: could not patch $proton" >&2
      ;;
  esac
done

if [ "$mode" != patch-proton ]; then
for py in "$common"/SteamLinuxRuntime*/steamrt*_platform_*/files/bin/python3.* "$common"/SteamLinuxRuntime*/sniper_platform_*/files/bin/python3.*; do
  [ -x "$py" ] || continue
  bindir="${py%/*}"
  base="${py##*/}"
  ln -sfn "$base" "$bindir/python3"
  ln -sfn "$base" "$bindir/python"
done
fi
