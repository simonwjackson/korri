+  std::string korri_input_seat_json_escape(std::string_view value) {
+    std::string escaped;
+    escaped.reserve(value.size());
+    for (auto ch : value) {
+      switch (ch) {
+        case '\\':
+          escaped += "\\\\";
+          break;
+        case '"':
+          escaped += "\\\"";
+          break;
+        case '\n':
+          escaped += "\\n";
+          break;
+        case '\r':
+          escaped += "\\r";
+          break;
+        case '\t':
+          escaped += "\\t";
+          break;
+        default:
+          escaped += ch;
+          break;
+      }
+    }
+    return escaped;
+  }
+
+  bool korri_input_seat_json_field(std::string_view json, std::string_view name, std::string &out) {
+    auto key = std::string{"\""} + std::string{name} + "\"";
+    auto key_pos = json.find(key);
+    if (key_pos == std::string_view::npos) return false;
+    auto colon_pos = json.find(':', key_pos + key.size());
+    if (colon_pos == std::string_view::npos) return false;
+    auto quote_pos = json.find('"', colon_pos + 1);
+    if (quote_pos == std::string_view::npos) return false;
+
+    std::string value;
+    for (auto index = quote_pos + 1; index < json.size(); ++index) {
+      auto ch = json[index];
+      if (ch == '"') {
+        out = value;
+        return true;
+      }
+      if (ch == '\\' && index + 1 < json.size()) {
+        value += json[index + 1];
+        ++index;
+      } else {
+        value += ch;
+      }
+    }
+    return false;
+  }
+
+  const char *korri_input_seat_socket_path() {
+    auto socket_path = std::getenv("KORRI_INPUT_SEAT_MIRROR_SOCKET");
+    if (socket_path == nullptr || socket_path[0] == '\0') {
+      return nullptr;
+    }
+    return socket_path;
+  }
+
+  std::string korri_input_seat_sidecar_path() {
+    auto runtime_dir = std::getenv("KORRI_INPUT_SEAT_RUNTIME_DIR");
+    if (runtime_dir == nullptr || runtime_dir[0] == '\0') {
+      return {};
+    }
+    std::string dir {runtime_dir};
+    if (dir[0] != '/' || dir.find('%') != std::string::npos) {
+      if (!korri_input_seat_logged_bad_sidecar_path.exchange(true)) {
+        BOOST_LOG(warning) << "invalid input seat mirror runtime directory"sv;
+      }
+      return {};
+    }
+    if (!dir.empty() && dir.back() == '/') {
+      dir.pop_back();
+    }
+    return dir + "/" + std::string{KORRI_INPUT_SEAT_SIDECAR_NAME};
+  }
+
+  korri_input_seat_active_launch_t korri_input_seat_active_launch() {
+    auto sidecar_path = korri_input_seat_sidecar_path();
+    if (sidecar_path.empty()) {
+      return {};
+    }
+
+    std::ifstream sidecar {sidecar_path};
+    if (!sidecar) {
+      return {};
+    }
+    std::stringstream buffer;
+    buffer << sidecar.rdbuf();
+    auto json = buffer.str();
+
+    korri_input_seat_active_launch_t active;
+    active.ready = korri_input_seat_json_field(json, "launchId"sv, active.launch_id) &&
+                   korri_input_seat_json_field(json, "mirrorToken"sv, active.mirror_token) &&
+                   !active.launch_id.empty() && !active.mirror_token.empty();
+    if (!active.ready && !korri_input_seat_logged_bad_sidecar.exchange(true)) {
+      BOOST_LOG(warning) << "invalid input seat mirror active-launch sidecar"sv;
+    }
+    return active;
+  }
+
+  bool korri_input_seat_mirror_ready(const char *socket_path, const korri_input_seat_active_launch_t &active) {
+    if (socket_path == nullptr || !active.ready) {
+      if (!korri_input_seat_logged_disabled.exchange(true)) {
+        BOOST_LOG(debug) << "input seat mirror disabled: missing KORRI_INPUT_SEAT_MIRROR_SOCKET or active launch sidecar"sv;
+      }
+      return false;
+    }
+
+    if (socket_path[0] != '/' || std::strlen(socket_path) >= sizeof(sockaddr_un::sun_path)) {
+      if (!korri_input_seat_logged_bad_socket_path.exchange(true)) {
+        BOOST_LOG(warning) << "invalid input seat mirror socket path"sv;
+      }
+      return false;
+    }
+
+    return true;
+  }
+
+  void korri_input_seat_emit_json(std::string_view json, const korri_input_seat_active_launch_t &active) {
+    auto socket_path = korri_input_seat_socket_path();
+    if (!korri_input_seat_mirror_ready(socket_path, active)) {
+      return;
+    }
+
+    std::string envelope;
+    envelope.reserve(json.size() + active.mirror_token.size() + 64);
+    envelope += "{\"mirrorToken\":\"";
+    envelope += korri_input_seat_json_escape(active.mirror_token);
+    envelope += "\",\"frame\":";
+    envelope += json;
+    envelope += "}";
+
+    if (envelope.size() + 1 > KORRI_INPUT_SEAT_MAX_FRAME_BYTES) {
+      if (!korri_input_seat_logged_oversized_frame.exchange(true)) {
+        BOOST_LOG(warning) << "input seat mirror frame exceeded maximum size"sv;
+      }
+      return;
+    }
+
+    auto fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+      if (!korri_input_seat_logged_connect_failure.exchange(true)) {
+        BOOST_LOG(warning) << "failed to create input seat mirror socket"sv;
+      }
+      return;
+    }
+
+    sockaddr_un addr {};
+    addr.sun_family = AF_UNIX;
+    std::strncpy(addr.sun_path, socket_path, sizeof(addr.sun_path) - 1);
+
+    if (::connect(fd, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)) < 0) {
+      if (!korri_input_seat_logged_connect_failure.exchange(true)) {
+        BOOST_LOG(warning) << "failed to connect input seat mirror socket"sv;
+      }
+      ::close(fd);
+      return;
+    }
+
+    std::string frame {envelope};
+    frame += '\n';
+    std::size_t written = 0;
+    while (written < frame.size()) {
+#ifdef MSG_NOSIGNAL
+      auto result = ::send(fd, frame.data() + written, frame.size() - written, MSG_NOSIGNAL);
+#else
+      auto result = ::send(fd, frame.data() + written, frame.size() - written, 0);
+#endif
+      if (result <= 0) {
+        if (!korri_input_seat_logged_write_failure.exchange(true)) {
+          BOOST_LOG(warning) << "failed to write input seat mirror frame"sv;
+        }
+        ::close(fd);
+        return;
+      }
+      written += static_cast<std::size_t>(result);
+    }
+
+    ::close(fd);
+  }
