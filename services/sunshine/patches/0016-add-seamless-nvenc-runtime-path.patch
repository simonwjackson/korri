+// video after FFmpeg and NVENC public types are available.
+enum { KORRI_NVENC_MAX_REGISTERED_FRAMES = 64 };
+
+struct korri_nvenc_dynload_functions_t {
+  void *cuda_dl;
+  void *nvenc_dl;
+  NV_ENCODE_API_FUNCTION_LIST nvenc_funcs;
+  int nvenc_device_count;
+};
+
+struct korri_nvenc_registered_frame_t {
+  void *ptr;
+  int ptr_index;
+  NV_ENC_REGISTERED_PTR regptr;
+  int mapped;
+  NV_ENC_MAP_INPUT_RESOURCE in_map;
+};
+
+struct korri_nvenc_context_t {
+  void *avclass;
+  korri_nvenc_dynload_functions_t nvenc_dload_funcs;
+  NV_ENC_INITIALIZE_PARAMS init_encode_params;
