+  bool runtime_update_h264_nvenc_bitrate(encode_session_t *session, std::uint32_t bitrate_kbps, std::uint32_t fps) {
+    // Defense in depth: these match stream.cpp's advertised and queue-time bounds.
+    if (bitrate_kbps < 500u || bitrate_kbps > 150000u || fps == 0) {
+      return false;
+    }
+    if (!runtime_h264_nvenc_bitrate_supported(session)) {
+      BOOST_LOG(warning) << "live-settings-mvp: runtime NVENC bitrate update rejected by private-state guard"sv;
+      return false;
+    }
+
+    auto avcodec_session = dynamic_cast<avcodec_encode_session_t *>(session);
+    auto *avctx = avcodec_session->avcodec_ctx.get();
+    auto *nvenc = reinterpret_cast<korri_nvenc_context_t *>(avctx->priv_data);
+    std::uint64_t requested_bps = (std::uint64_t) bitrate_kbps * 1000u;
+    if (requested_bps == 0 || requested_bps > std::numeric_limits<std::uint32_t>::max()) {
+      return false;
+    }
+
+    const auto bps = (std::uint32_t) requested_bps;
+    auto updated_config = nvenc->encode_config;
+    auto updated_init = nvenc->init_encode_params;
+    std::uint64_t scaled_buffer = fps > 0 ? bps / fps : 0;
+    if (scaled_buffer > 0 && config::video.nv_legacy.vbv_percentage_increase > 0) {
+      scaled_buffer += scaled_buffer * config::video.nv_legacy.vbv_percentage_increase / 100;
+    }
+    if (scaled_buffer == 0 || scaled_buffer > std::numeric_limits<std::uint32_t>::max()) {
+      return false;
+    }
+
+    updated_config.rcParams.averageBitRate = bps;
+    updated_config.rcParams.maxBitRate = bps;
+    updated_config.rcParams.vbvBufferSize = (std::uint32_t) scaled_buffer;
+    updated_init.encodeConfig = &updated_config;
+
+    NV_ENC_RECONFIGURE_PARAMS params {};
+    params.version = NV_ENC_RECONFIGURE_PARAMS_VER;
+    params.reInitEncodeParams = updated_init;
+    params.resetEncoder = 1;
+    params.forceIDR = 1;
+
+    const auto result = nvenc->nvenc_dload_funcs.nvenc_funcs.nvEncReconfigureEncoder(nvenc->nvencoder, &params);
+    if (result != NV_ENC_SUCCESS) {
+      BOOST_LOG(warning)
+        << "live-settings-mvp: NvEncReconfigureEncoder failed requested_kbps="sv << bitrate_kbps
+        << " nvenc_status="sv << (int) result;
+      return false;
+    }
+
+    nvenc->encode_config.rcParams = updated_config.rcParams;
+    avctx->bit_rate = bps;
+    avctx->rc_max_rate = bps;
+    avctx->rc_min_rate = bps;
+    avctx->rc_buffer_size = (int) updated_config.rcParams.vbvBufferSize;
+    avctx->rc_initial_buffer_occupancy = avctx->rc_buffer_size * 3 / 4;
+
+    BOOST_LOG(info)
+      << "live-settings-mvp: NVENC runtime bitrate reconfigured without encoder restart requested_kbps="sv << bitrate_kbps
+      << " average_bps="sv << updated_config.rcParams.averageBitRate
+      << " max_bps="sv << updated_config.rcParams.maxBitRate
+      << " vbv_buffer="sv << updated_config.rcParams.vbvBufferSize;
+    return true;
+  }
