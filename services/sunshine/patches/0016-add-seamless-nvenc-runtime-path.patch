+  void *cu_context_internal;
+  void *cu_stream;
+  void *d3d11_device;
+  void *frame;
+  int nb_surfaces;
+  void *surfaces;
+  void *frame_data_array;
+  int frame_data_array_nb;
+  int frame_data_array_pos;
+  void *unused_surface_queue;
+  void *output_surface_queue;
+  void *output_surface_ready_queue;
+  void *timestamp_list;
+  std::uint64_t output_frame_num;
+  std::int64_t initial_delay_time;
+  NV_ENC_SEI_PAYLOAD *sei_data;
+  int sei_data_size;
+  korri_nvenc_registered_frame_t registered_frames[KORRI_NVENC_MAX_REGISTERED_FRAMES];
+  int nb_registered_frames;
+  int data_pix_fmt;
+  int support_dyn_bitrate;
+  void *nvencoder;
+  std::uint32_t frame_idx_counter;
