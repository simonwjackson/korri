+
+    auto avcodec_session = dynamic_cast<avcodec_encode_session_t *>(session);
+    auto *avctx = avcodec_session->avcodec_ctx.get();
+    auto *vaapi = reinterpret_cast<korri_vaapi_encode_context_t *>(avctx->priv_data);
+    std::uint64_t requested_bps = (std::uint64_t) bitrate_kbps * 1000u;
+    if (requested_bps == 0 || requested_bps > std::numeric_limits<std::uint32_t>::max()) {
+      return false;
+    }
+
+    auto bps = (std::uint32_t) requested_bps;
+    avctx->bit_rate = bps;
+    avctx->rc_max_rate = bps;
+    avctx->rc_min_rate = bps;
+    if (fps > 0) {
+      avctx->rc_buffer_size = bps / fps;
+      avctx->rc_initial_buffer_occupancy = avctx->rc_buffer_size * 3 / 4;
+    }
+
+    vaapi->va_bit_rate = bps;
+    vaapi->rc_params.bits_per_second = bps;
+    vaapi->rc_params.target_percentage = 100;
+    if (vaapi->rc_mode->hrd && avctx->rc_buffer_size > 0) {
+      vaapi->hrd_params.buffer_size = (std::uint32_t) avctx->rc_buffer_size;
+      vaapi->hrd_params.initial_buffer_fullness = (std::uint32_t) avctx->rc_initial_buffer_occupancy;
+      vaapi->rc_params.window_size = (std::uint32_t) (((std::uint64_t) vaapi->hrd_params.buffer_size * 1000u) / bps);
+    } else if (vaapi->rc_params.window_size == 0) {
+      vaapi->rc_params.window_size = 1000;
+    }
+
+    avcodec_session->request_idr_frame();
+    BOOST_LOG(info)
+      << "live-settings-mvp: VAAPI runtime bitrate params updated without encoder restart requested_kbps="sv << bitrate_kbps
+      << " bits_per_second="sv << vaapi->rc_params.bits_per_second
+      << " target_percentage="sv << vaapi->rc_params.target_percentage
+      << " window_size="sv << vaapi->rc_params.window_size
+      << " rc_mode="sv << (vaapi->rc_mode->name ? vaapi->rc_mode->name : "unknown");
+    return true;
+  }
