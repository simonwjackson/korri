+  bool runtime_h264_vaapi_bitrate_supported(encode_session_t *session) {
+    auto avcodec_session = dynamic_cast<avcodec_encode_session_t *>(session);
+    if (!avcodec_session || !avcodec_session->avcodec_ctx || !avcodec_session->device) {
+      return false;
+    }
+
+    auto *avctx = avcodec_session->avcodec_ctx.get();
+    if (avctx->codec_id != AV_CODEC_ID_H264 || avctx->pix_fmt != AV_PIX_FMT_VAAPI || avctx->priv_data == nullptr) {
+      return false;
+    }
+
+    auto *vaapi = reinterpret_cast<korri_vaapi_encode_context_t *>(avctx->priv_data);
+    if (!vaapi->rc_mode || !vaapi->rc_mode->bitrate || vaapi->nb_global_params <= 0 || vaapi->nb_global_params > KORRI_VAAPI_MAX_GLOBAL_PARAMS) {
+      return false;
+    }
+
+    for (int i = 0; i < vaapi->nb_global_params; ++i) {
+      if (vaapi->global_params_type[i] == VAEncMiscParameterTypeRateControl && vaapi->global_params[i] == &vaapi->rc_params) {
+        return true;
+      }
+    }
+    return false;
+  }
