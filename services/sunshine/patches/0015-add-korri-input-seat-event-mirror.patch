+    auto active = korri_input_seat_active_launch();
+    auto out = korri_input_seat_frame_prefix("source-disconnected"sv, controller_number, active.launch_id);
+    out << ",\"reason\":\"" << korri_input_seat_json_escape(reason) << "\"}";
+    korri_input_seat_emit_json(out.str(), active);
