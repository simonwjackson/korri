+        << ",\"rightTrigger\":" << static_cast<std::uint32_t>(packet->rightTrigger)
+        << ",\"leftStickX\":" << static_cast<std::int32_t>(packet->leftStickX)
+        << ",\"leftStickY\":" << static_cast<std::int32_t>(packet->leftStickY)
+        << ",\"rightStickX\":" << static_cast<std::int32_t>(packet->rightStickX)
+        << ",\"rightStickY\":" << static_cast<std::int32_t>(packet->rightStickY)
+        << '}';
+    korri_input_seat_emit_json(out.str(), active);
+    return true;
+  }
+#else
+  bool korri_input_seat_emit_source_connected(std::int32_t) { return false; }
+  bool korri_input_seat_emit_source_disconnected(std::int32_t, std::string_view) { return false; }
+  bool korri_input_seat_emit_source_state(PNV_MULTI_CONTROLLER_PACKET) { return false; }
+#endif
