+    auto active = korri_input_seat_active_launch();
+    auto out = korri_input_seat_frame_prefix("source-connected"sv, controller_number, active.launch_id);
+    out << '}';
+    korri_input_seat_emit_json(out.str(), active);
+    return true;
+  }
+
+  bool korri_input_seat_emit_source_disconnected(std::int32_t controller_number, std::string_view reason) {
