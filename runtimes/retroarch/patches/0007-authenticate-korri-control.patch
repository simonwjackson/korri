From 86a1ebbc0a2c02fed01c7d180709ee66f1942bda Mon Sep 17 00:00:00 2001
From: Korri patch builder <patches@korri.invalid>
Date: Wed, 29 Jul 2026 21:47:17 -0600
Subject: [PATCH] Authenticate Korri control commands

---
 command.c                        | 32 ++++++++++++++++++++++++++++----
 command.h                        |  1 +
 frontend/drivers/platform_unix.c | 16 ++++++++++++++--
 3 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/command.c b/command.c
index 0969180..97ccfd9 100644
--- a/command.c
+++ b/command.c
@@ -179,6 +179,15 @@ static void command_parse_msg(command_t *handle, char *buf)
 }
 
 #if defined(HAVE_NETWORK_CMD)
+static char network_command_token[65];
+
+void command_network_set_token(const char *token)
+{
+   network_command_token[0] = '\0';
+   if (token && strlen(token) == 64)
+      strlcpy(network_command_token, token, sizeof(network_command_token));
+}
+
 typedef struct
 {
    /* Network socket FD */
@@ -231,19 +240,34 @@ static void command_network_poll(command_t *handle)
 
 #if defined(ANDROID)
       {
+         char *command;
          char *line_end = strpbrk(buf, "\r\n");
          if (line_end)
             *line_end = '\0';
-         if (     strcmp(buf, "GET_STATUS") != 0
-               && strcmp(buf, "QUIT") != 0)
+         command = strchr(buf, ' ');
+         if (!command)
+         {
+            RARCH_WARN("[NetCMD] Rejected unauthenticated Korri command.\n");
+            continue;
+         }
+         *command++ = '\0';
+         if (     string_is_empty(network_command_token)
+               || !string_is_equal(buf, network_command_token))
+         {
+            RARCH_WARN("[NetCMD] Rejected unauthenticated Korri command.\n");
+            continue;
+         }
+         if (     strcmp(command, "GET_STATUS") != 0
+               && strcmp(command, "QUIT") != 0)
          {
             RARCH_WARN("[NetCMD] Rejected command outside Korri allowlist.\n");
             continue;
          }
+         command_parse_msg(handle, command);
       }
-#endif
-
+#else
       command_parse_msg(handle, buf);
+#endif
    }
 }
 
diff --git a/command.h b/command.h
index 6fd2565..b836b5e 100644
--- a/command.h
+++ b/command.h
@@ -343,6 +343,7 @@ bool command_event(enum event_command action, void *data);
 #ifdef HAVE_NETWORK_CMD
 command_t* command_network_new(uint16_t port);
 bool command_network_send(const char *cmd_);
+void command_network_set_token(const char *token);
 #endif
 #ifdef HAVE_STDIN_CMD
 command_t* command_stdin_new(void);
diff --git a/frontend/drivers/platform_unix.c b/frontend/drivers/platform_unix.c
index e4ffe0f..c94f07c 100644
--- a/frontend/drivers/platform_unix.c
+++ b/frontend/drivers/platform_unix.c
@@ -87,12 +87,11 @@
 #include "../../paths.h"
 #include "../../retroarch.h"
 #include "../../verbosity.h"
+#include "../../command.h"
 
 #ifdef HAVE_MENU
 #include "../../menu/menu_driver.h"
 #include "../../menu/menu_entries.h"
-#else
-#include "../../command.h"
 #endif
 
 #include "platform_unix.h"
@@ -1425,6 +1424,19 @@ static void frontend_unix_get_env(int *argc,
    __android_log_print(ANDROID_LOG_INFO,
       "RetroArch", "[ENV] Checking arguments passed from intent ...\n");
 
+#ifdef HAVE_NETWORK_CMD
+   /* Reject all Android network commands unless Korri supplied a signed token. */
+   command_network_set_token(NULL);
+   CALL_OBJ_METHOD_PARAM(env, jstr, obj, android_app->getStringExtra,
+         (*env)->NewStringUTF(env, "KORRI_CONTROL_TOKEN"));
+   if (android_app->getStringExtra && jstr)
+   {
+      const char *token = (*env)->GetStringUTFChars(env, jstr, 0);
+      command_network_set_token(token);
+      (*env)->ReleaseStringUTFChars(env, jstr, token);
+   }
+#endif
+
    /* Config file. */
    CALL_OBJ_METHOD_PARAM(env, jstr, obj, android_app->getStringExtra,
          (*env)->NewStringUTF(env, "CONFIGFILE"));
-- 
