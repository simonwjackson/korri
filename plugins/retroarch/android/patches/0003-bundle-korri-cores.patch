+  private void installBundledCore() {
+    File coreDir = new File(getApplicationInfo().dataDir, "cores");
+    File target = new File(coreDir, "mgba_libretro_android.so");
+    File temporary = new File(coreDir, "mgba_libretro_android.so.tmp");
+    if (!coreDir.isDirectory() && !coreDir.mkdirs()) {
+      throw new IllegalStateException("Cannot create bundled core directory");
+    }
+    try (InputStream input = getAssets().open("cores/mgba_libretro_android.so");
+         FileOutputStream output = new FileOutputStream(temporary, false)) {
+      byte[] buffer = new byte[64 * 1024];
+      int count;
+      while ((count = input.read(buffer)) != -1) {
+        output.write(buffer, 0, count);
+      }
+      output.getFD().sync();
+    } catch (IOException error) {
+      throw new IllegalStateException("Cannot install bundled mGBA core", error);
+    }
+    // Android's rename is an atomic same-directory replacement. Do not
+    // delete the last-known-good core before the replacement is durable.
+    if (!temporary.renameTo(target)) {
+      throw new IllegalStateException("Cannot publish bundled mGBA core");
+    }
+    target.setReadable(true, true);
+    target.setExecutable(true, true);
+  }
+
