 static void korri_secure_wipe(void *value, size_t len)
 {
@@ -196,6 +200,13 @@ static void korri_secure_wipe(void *value, size_t len)
       *cursor++ = 0;
 }
 
+static void korri_reset_nonce_window(void)
+{
+   korri_secure_wipe(request_nonces, sizeof(request_nonces));
+   request_nonce_count  = 0;
+   request_nonce_cursor = 0;
+}
+
 static bool korri_valid_token(const char *token)
 {
    size_t i;
@@ -210,6 +221,7 @@ static bool korri_valid_token(const char *token)
 
 void command_network_set_token(const char *token)
 {
+   korri_reset_nonce_window();
    korri_secure_wipe(network_command_token, sizeof(network_command_token));
    if (korri_valid_token(token))
       memcpy(network_command_token, token, 64);
@@ -292,6 +304,27 @@ static bool korri_constant_time_equal(const uint8_t *left,
    return difference == 0;
 }
 
+static bool korri_nonce_seen(const uint8_t *nonce)
+{
+   size_t i;
+   uint8_t seen = 0;
+   for (i = 0; i < KORRI_NONCE_WINDOW_SIZE; i++)
+   {
+      uint8_t active = (uint8_t)(i < request_nonce_count);
+      seen |= active & (uint8_t)korri_constant_time_equal(
+            request_nonces[i], nonce, KORRI_NONCE_SIZE);
+   }
+   return seen != 0;
+}
+
+static void korri_remember_nonce(const uint8_t *nonce)
+{
+   memcpy(request_nonces[request_nonce_cursor], nonce, KORRI_NONCE_SIZE);
+   request_nonce_cursor = (request_nonce_cursor + 1) % KORRI_NONCE_WINDOW_SIZE;
+   if (request_nonce_count < KORRI_NONCE_WINDOW_SIZE)
+      request_nonce_count++;
+}
+
 typedef struct
