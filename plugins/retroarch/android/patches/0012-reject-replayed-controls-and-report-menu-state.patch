 #define KORRI_MAX_RESULT_SIZE 4096
+#define KORRI_NONCE_WINDOW_SIZE 32
 
 static char network_command_token[65];
+static uint8_t request_nonces[KORRI_NONCE_WINDOW_SIZE][KORRI_NONCE_SIZE];
+static size_t request_nonce_count;
