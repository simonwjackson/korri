 static void network_command_reply(command_t *cmd,
    const char *s, size_t len)
 {
    command_network_t *netcmd = (command_network_t*)cmd->userptr;
-   /* Respond (fire and forget since it's UDP) */
+#if defined(ANDROID)
+   if (netcmd->authenticated_request && len <= KORRI_MAX_RESULT_SIZE)
+   {
+      size_t framed_len = KORRI_RESPONSE_PREFIX_SIZE + len;
+      uint8_t *reply = (uint8_t*)malloc(framed_len + KORRI_MAC_SIZE);
+      if (!reply)
+         return;
+      reply[0] = KORRI_PROTOCOL_VERSION;
+      memcpy(reply + 1, netcmd->request_nonce, KORRI_NONCE_SIZE);
+      reply[1 + KORRI_NONCE_SIZE] = netcmd->request_command;
+      reply[1 + KORRI_NONCE_SIZE + 1] = (uint8_t)(len >> 8);
+      reply[1 + KORRI_NONCE_SIZE + 2] = (uint8_t)len;
+      memcpy(reply + KORRI_RESPONSE_PREFIX_SIZE, s, len);
+      if (korri_hmac_sha256(netcmd->token, reply, framed_len,
+               reply + framed_len))
+         sendto(netcmd->net_fd, reply, framed_len + KORRI_MAC_SIZE, 0,
+            (struct sockaddr*)&netcmd->cmd_source, netcmd->cmd_source_len);
+      korri_secure_wipe(reply, framed_len + KORRI_MAC_SIZE);
+      free(reply);
+      return;
+   }
+#endif
    sendto(netcmd->net_fd, s, len, 0,
       (struct sockaddr*)&netcmd->cmd_source, netcmd->cmd_source_len);
 }
