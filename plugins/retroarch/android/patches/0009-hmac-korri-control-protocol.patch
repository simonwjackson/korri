 #if defined(HAVE_NETWORK_CMD)
+#define KORRI_PROTOCOL_VERSION 1
+#define KORRI_NONCE_SIZE 32
+#define KORRI_MAC_SIZE 32
+#define KORRI_REQUEST_SIZE (1 + KORRI_NONCE_SIZE + 1 + KORRI_MAC_SIZE)
+#define KORRI_RESPONSE_PREFIX_SIZE (1 + KORRI_NONCE_SIZE + 1 + 2)
+#define KORRI_MAX_RESULT_SIZE 4096
+
 static char network_command_token[65];
 
+static void korri_secure_wipe(void *value, size_t len)
+{
+   volatile uint8_t *cursor = (volatile uint8_t*)value;
+   while (len--)
+      *cursor++ = 0;
+}
+
+static bool korri_valid_token(const char *token)
+{
+   size_t i;
+   if (!token || strlen(token) != 64)
+      return false;
+   for (i = 0; i < 64; i++)
+      if (!(     (token[i] >= '0' && token[i] <= '9')
+            || (token[i] >= 'a' && token[i] <= 'f')))
+         return false;
+   return true;
+}
+
 void command_network_set_token(const char *token)
 {
-   network_command_token[0] = '\0';
-   if (token && strlen(token) == 64)
-      strlcpy(network_command_token, token, sizeof(network_command_token));
+   korri_secure_wipe(network_command_token, sizeof(network_command_token));
+   if (korri_valid_token(token))
+      memcpy(network_command_token, token, 64);
+}
+
+static bool korri_hex_decode_32(const char *hex, uint8_t *output)
+{
+   size_t i;
+   for (i = 0; i < 32; i++)
+   {
+      unsigned high;
+      unsigned low;
+      char a = hex[i * 2];
+      char b = hex[i * 2 + 1];
+      high = (a >= '0' && a <= '9') ? (unsigned)(a - '0')
+         : (a >= 'a' && a <= 'f') ? (unsigned)(a - 'a' + 10) : 16;
+      low = (b >= '0' && b <= '9') ? (unsigned)(b - '0')
+         : (b >= 'a' && b <= 'f') ? (unsigned)(b - 'a' + 10) : 16;
+      if (high > 15 || low > 15)
+         return false;
+      output[i] = (uint8_t)((high << 4) | low);
+   }
+   return true;
+}
+
+/* Pinned RetroArch exposes SHA-256 through sha256_hash(). This is the
+ * standard HMAC construction over the exact binary frame bytes. */
+static bool korri_hmac_sha256(const char *token,
+      const uint8_t *frame, size_t frame_len, uint8_t *output)
+{
+   size_t i;
+   uint8_t ipad[64];
+   uint8_t opad[64];
+   uint8_t inner_digest[32];
+   uint8_t outer_frame[96];
+   char inner_hex[65];
+   char outer_hex[65];
+   uint8_t *inner_frame = (uint8_t*)malloc(64 + frame_len);
+   if (!inner_frame || !korri_valid_token(token))
+   {
+      free(inner_frame);
+      return false;
+   }
+   for (i = 0; i < 64; i++)
+   {
+      ipad[i] = ((uint8_t)token[i]) ^ 0x36;
+      opad[i] = ((uint8_t)token[i]) ^ 0x5c;
+   }
+   memcpy(inner_frame, ipad, 64);
+   memcpy(inner_frame + 64, frame, frame_len);
+   sha256_hash(inner_hex, inner_frame, 64 + frame_len);
+   if (!korri_hex_decode_32(inner_hex, inner_digest))
+   {
+      korri_secure_wipe(inner_frame, 64 + frame_len);
+      free(inner_frame);
+      return false;
+   }
+   memcpy(outer_frame, opad, 64);
+   memcpy(outer_frame + 64, inner_digest, 32);
+   sha256_hash(outer_hex, outer_frame, sizeof(outer_frame));
+   i = korri_hex_decode_32(outer_hex, output);
+   korri_secure_wipe(inner_frame, 64 + frame_len);
+   korri_secure_wipe(ipad, sizeof(ipad));
+   korri_secure_wipe(opad, sizeof(opad));
+   korri_secure_wipe(inner_digest, sizeof(inner_digest));
+   korri_secure_wipe(outer_frame, sizeof(outer_frame));
+   korri_secure_wipe(inner_hex, sizeof(inner_hex));
+   korri_secure_wipe(outer_hex, sizeof(outer_hex));
+   free(inner_frame);
+   return i != 0;
+}
+
+static bool korri_constant_time_equal(const uint8_t *left,
+      const uint8_t *right, size_t len)
+{
+   size_t i;
+   uint8_t difference = 0;
+   for (i = 0; i < len; i++)
+      difference |= left[i] ^ right[i];
+   return difference == 0;
 }
 
