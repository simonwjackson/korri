diff --git a/input/drivers/android_input.c b/input/drivers/android_input.c
index 1e475bd..91d59a2 100644
--- a/input/drivers/android_input.c
+++ b/input/drivers/android_input.c
@@ -416,9 +416,26 @@ static void android_input_poll_main_cmd(void)
          slock_unlock(android_app->mutex);
          break;
 
+      case APP_CMD_PAUSE:
+         {
+            settings_t *settings         = config_get_ptr();
+            runloop_state_t *runloop_st  = runloop_state_get_ptr();
+
+            /* Korri synchronously persists the auto state before Android pause.
+             * The NativeActivity callback waits for this command to complete,
+             * so suspension or an immediate process kill cannot truncate it. */
+            if (     settings
+                  && runloop_st
+                  && (runloop_st->flags & RUNLOOP_FLAG_CORE_RUNNING)
+                  && settings->bools.savestate_auto_save)
+            {
+               command_event_save_auto_state();
+               content_wait_for_save_state_task();
+            }
+         }
+         /* fallthrough */
       case APP_CMD_RESUME:
       case APP_CMD_START:
-      case APP_CMD_PAUSE:
       case APP_CMD_STOP:
          slock_lock(android_app->mutex);
          android_app->activityState = cmd;
