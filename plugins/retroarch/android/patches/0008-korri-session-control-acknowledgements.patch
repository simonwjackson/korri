diff --git a/command.c b/command.c
index 97ccfd9..7ae6a0c 100644
--- a/command.c
+++ b/command.c
@@ -258,12 +258,30 @@ static void command_network_poll(command_t *handle)
             continue;
          }
          if (     strcmp(command, "GET_STATUS") != 0
+               && strcmp(command, "SHOW_MENU") != 0
                && strcmp(command, "QUIT") != 0)
          {
             RARCH_WARN("[NetCMD] Rejected command outside Korri allowlist.\n");
             continue;
          }
+         if (strcmp(command, "SHOW_MENU") == 0)
+         {
+#ifdef HAVE_MENU
+            struct menu_state *menu_st = menu_state_get_ptr();
+            if (!(menu_st->flags & MENU_ST_FLAG_ALIVE))
+               command_event(CMD_EVENT_MENU_TOGGLE, NULL);
+            if (menu_st->flags & MENU_ST_FLAG_ALIVE)
+               handle->replier(handle, "SHOW_MENU OK", STRLEN_CONST("SHOW_MENU OK"));
+            else
+               handle->replier(handle, "SHOW_MENU ERROR", STRLEN_CONST("SHOW_MENU ERROR"));
+#else
+            handle->replier(handle, "SHOW_MENU ERROR", STRLEN_CONST("SHOW_MENU ERROR"));
+#endif
+            continue;
+         }
          command_parse_msg(handle, command);
+         if (strcmp(command, "QUIT") == 0)
+            handle->replier(handle, "QUIT OK", STRLEN_CONST("QUIT OK"));
       }
 #else
       command_parse_msg(handle, buf);
