#!/usr/bin/env nix-shell
#! nix-shell -i bash -p bash curl jq yq-go coreutils gnused gnugrep findutils

set -euo pipefail

usage() {
  cat <<'USAGE'
Fetch SteamGridDB grid artwork for the remaining Korri games.

Requires:
  SGDB_API_KEY              SteamGridDB API key (required)

Optional env:
  KORRI_LIBRARY             Library YAML path
                            default: ~/.local/share/korri/library/library.yaml
  OUT_DIR                   Download target
                            default: ${XDG_CACHE_HOME:-~/.cache}/korri/game-assets/candidates/steamgriddb
  SGDB_TYPES                SteamGridDB grid types to fetch
                            default: static
  MAX_PER_RATIO             Max images per game+ratio; 0 means all
                            default: 0
  SLEEP_SECONDS             Delay between API calls/downloads
                            default: 0.2

Ratios fetched:
  1x1    512x512,1024x1024
  92x43  460x215,920x430
  2x3    600x900,342x482,660x930

Examples:
  SGDB_API_KEY=... /tmp/fetch-korri-steamgriddb-art
  SGDB_API_KEY=... OUT_DIR=/tmp/sgdb MAX_PER_RATIO=3 /tmp/fetch-korri-steamgriddb-art
USAGE
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ -z "${SGDB_API_KEY:-}" ]]; then
  echo "error: SGDB_API_KEY is required; get one from https://www.steamgriddb.com/profile/preferences/api" >&2
  exit 2
fi

LIBRARY="${KORRI_LIBRARY:-$HOME/.local/share/korri/library/library.yaml}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
OUT_DIR="${OUT_DIR:-$CACHE_HOME/korri/game-assets/candidates/steamgriddb}"
SGDB_TYPES="${SGDB_TYPES:-static}"
MAX_PER_RATIO="${MAX_PER_RATIO:-0}"
SLEEP_SECONDS="${SLEEP_SECONDS:-0.2}"
API_BASE="https://www.steamgriddb.com/api/v2"

if [[ ! -f "$LIBRARY" ]]; then
  echo "error: library not found: $LIBRARY" >&2
  exit 2
fi

mkdir -p "$OUT_DIR"
manifest="$OUT_DIR/manifest.jsonl"
errors="$OUT_DIR/errors.jsonl"
: > "$manifest"
: > "$errors"

safe_name() {
  printf '%s' "$1" | tr '/[:space:]' '__' | sed -E 's/[^A-Za-z0-9._-]+/_/g; s/_+/_/g; s/^_//; s/_$//'
}

urlencode() {
  jq -nr --arg value "$1" '$value | @uri'
}

api_get() {
  local url="$1"
  shift
  curl -fsS --retry 3 --retry-delay 1 \
    -H "Authorization: Bearer $SGDB_API_KEY" \
    -H "Accept: application/json" \
    "$@" \
    "$url"
}

api_get_path() {
  local path="$1"
  api_get "$API_BASE/$path"
}

api_get_grids() {
  local sgdb_id="$1"
  local dimensions="$2"
  curl -fsS --retry 3 --retry-delay 1 -G \
    -H "Authorization: Bearer $SGDB_API_KEY" \
    -H "Accept: application/json" \
    --data-urlencode "dimensions=$dimensions" \
    --data-urlencode "types=$SGDB_TYPES" \
    --data-urlencode "nsfw=false" \
    --data-urlencode "humor=false" \
    "$API_BASE/grids/game/$sgdb_id"
}

choose_game_id() {
  local search_json="$1"
  local search_name="$2"
  jq -r --arg wanted "$search_name" '
    def norm: ascii_downcase | gsub("[^a-z0-9]+"; "");
    ($wanted | norm) as $wantedNorm |
    (.data // []) as $results |
    ([
      $results[]? | select((.name | norm) == $wantedNorm) | .id
    ][0]) // ([
      $results[]? | select((.name | norm) as $nameNorm | ($nameNorm | contains($wantedNorm)) or ($wantedNorm | contains($nameNorm))) | .id
    ][0]) // ($results[0].id // empty)
  ' <<<"$search_json"
}

declare -A SEARCH_NAMES=(
  ["nixpkgs/neverball"]="Neverball"
  ["nix/aaaaxy"]="Aaaaxy"
  ["nix/apotris"]="Apotris"
  ["nix/armagetronad"]="Armagetron Advanced"
  ["nix/astromenace"]="AstroMenace"
  ["nix/azimuth"]="Azimuth"
  ["nix/beyond-all-reason"]="Beyond All Reason"
  ["nix/bugdom"]="Bugdom"
  ["nix/chromium-bsu"]="Chromium B.S.U."
  ["nix/cro-mag-rally"]="Cro-Mag Rally"
  ["nix/endless-sky"]="Endless Sky"
  ["nix/etterna"]="Etterna"
  ["nix/extremetuxracer"]="Extreme Tux Racer"
  ["nix/flightgear"]="FlightGear"
  ["nix/garden-of-coloured-lights"]="Garden of Coloured Lights"
  ["nix/hedgewars"]="Hedgewars"
  ["nix/jumpnbump"]="Jump 'n Bump"
  ["nix/lincity-ng"]="Lincity-NG"
  ["nix/lugaru"]="Lugaru"
  ["nix/megaglest"]="MegaGlest"
  ["nix/mindustry"]="Mindustry"
  ["nix/mrrescue"]="Mr. Rescue"
  ["nix/naev"]="Naev"
  ["nix/nanosaur"]="Nanosaur"
  ["nix/nanosaur2"]="Nanosaur 2"
  ["nix/openarena"]="OpenArena"
  ["nix/openclonk"]="OpenClonk"
  ["nix/openlierox"]="OpenLieroX"
  ["nix/opensoldat"]="Soldat"
  ["nix/otto-matic"]="Otto Matic"
  ["nix/pioneer"]="Pioneer"
  ["nix/redeclipse"]="Red Eclipse"
  ["nix/speed-dreams"]="Speed Dreams"
  ["nix/stepmania"]="StepMania"
  ["nix/stuntrally"]="Stunt Rally"
  ["nix/supermariowar"]="Super Mario War"
  ["nix/supertux"]="SuperTux"
  ["nix/supertuxkart"]="SuperTuxKart"
  ["nix/the-legend-of-edgar"]="The Legend of Edgar"
  ["nix/the-powder-toy"]="The Powder Toy"
  ["nix/torus-trooper"]="Torus Trooper"
  ["nix/tumiki-fighters"]="Tumiki Fighters"
  ["nix/unvanquished"]="Unvanquished"
  ["nix/vdrift"]="VDrift"
  ["nix/veloren"]="Veloren"
  ["nix/warzone2100"]="Warzone 2100"
  ["nix/widelands"]="Widelands"
  ["nix/xmoto"]="X-Moto"
  ["nix/xonotic"]="Xonotic"
  ["nix/yarg"]="YARG"
  ["nix/zeroad"]="0 A.D."
  ["nix/ddnet"]="DDNet"
  ["nix/mari0"]="Mari0"
  ["nix/luanti"]="Minetest"
)

declare -A RATIO_DIMS=(
  ["1x1"]="512x512,1024x1024"
  ["92x43"]="460x215,920x430"
  ["2x3"]="600x900,342x482,660x930"
)
declare -A RATIO_ROLES=(
  ["1x1"]="tile"
  ["92x43"]="banner"
  ["2x3"]="poster"
)
ratios=("1x1" "92x43" "2x3")

game_count=0
download_count=0
skip_count=0
error_count=0

while IFS=$'\t' read -r game_id title content_path; do
  ((game_count += 1))
  search_name="${SEARCH_NAMES[$game_id]:-${title:-$content_path}}"
  game_slug="$(safe_name "$game_id")"
  game_dir="$OUT_DIR/$game_slug"
  mkdir -p "$game_dir"

  echo "[$game_count] $game_id -> $search_name"

  encoded_search="$(urlencode "$search_name")"
  if ! search_json="$(api_get_path "search/autocomplete/$encoded_search")"; then
    jq -nc --arg gameId "$game_id" --arg searchName "$search_name" --arg error "search_failed" \
      '{gameId:$gameId, searchName:$searchName, error:$error}' >> "$errors"
    ((error_count += 1))
    continue
  fi
  printf '%s\n' "$search_json" > "$game_dir/search.json"

  sgdb_id="$(choose_game_id "$search_json" "$search_name")"
  if [[ -z "$sgdb_id" || "$sgdb_id" == "null" ]]; then
    jq -nc --arg gameId "$game_id" --arg searchName "$search_name" --arg error "no_search_results" \
      '{gameId:$gameId, searchName:$searchName, error:$error}' >> "$errors"
    ((error_count += 1))
    continue
  fi

  echo "$sgdb_id" > "$game_dir/sgdb-game-id.txt"
  sleep "$SLEEP_SECONDS"

  for ratio in "${ratios[@]}"; do
    dims="${RATIO_DIMS[$ratio]}"
    ratio_dir="$game_dir/$ratio"
    mkdir -p "$ratio_dir"

    if ! grids_json="$(api_get_grids "$sgdb_id" "$dims")"; then
      jq -nc --arg gameId "$game_id" --arg searchName "$search_name" --arg sgdbId "$sgdb_id" --arg ratio "$ratio" --arg error "grids_failed" \
        '{gameId:$gameId, searchName:$searchName, sgdbId:$sgdbId, ratio:$ratio, error:$error}' >> "$errors"
      ((error_count += 1))
      continue
    fi
    printf '%s\n' "$grids_json" > "$ratio_dir/grids.json"

    mapfile -t images < <(
      jq -r --argjson max "$MAX_PER_RATIO" '
        (.data // [])
        | (if $max > 0 then .[:$max] else . end)
        | .[]
        | [.id, .url, (.dimensions // "unknown"), (.type // "unknown"), (.style // "unknown")] | @tsv
      ' <<<"$grids_json"
    )

    if [[ "${#images[@]}" -eq 0 ]]; then
      jq -nc --arg gameId "$game_id" --arg searchName "$search_name" --arg sgdbId "$sgdb_id" --arg ratio "$ratio" --arg dimensions "$dims" --arg error "no_images" \
        '{gameId:$gameId, searchName:$searchName, sgdbId:$sgdbId, ratio:$ratio, dimensions:$dimensions, error:$error}' >> "$errors"
      continue
    fi

    for image in "${images[@]}"; do
      IFS=$'\t' read -r image_id url dimensions image_type style <<< "$image"
      sanitized_url="${url%%\#*}"
      sanitized_url="${sanitized_url%%\?*}"
      url_path="$sanitized_url"
      ext="${url_path##*.}"
      if [[ "$ext" == "$url_path" || ${#ext} -gt 8 ]]; then
        ext="jpg"
      fi
      file_name="$(safe_name "${image_id}_${dimensions}_${style}_${image_type}").$ext"
      file="$ratio_dir/$file_name"
      relative_file="steamgriddb/$game_slug/$ratio/$file_name"
      role="${RATIO_ROLES[$ratio]}"
      if [[ -s "$file" ]]; then
        ((skip_count += 1))
      else
        tmp="$file.tmp"
        if curl -fsSL --retry 3 --retry-delay 1 -o "$tmp" "$url"; then
          mv "$tmp" "$file"
          ((download_count += 1))
        else
          rm -f "$tmp"
          jq -nc --arg gameId "$game_id" --arg searchName "$search_name" --arg sgdbId "$sgdb_id" --arg ratio "$ratio" --arg imageId "$image_id" --arg url "$url" --arg error "download_failed" \
            '{gameId:$gameId, searchName:$searchName, sgdbId:$sgdbId, ratio:$ratio, imageId:$imageId, url:$url, error:$error}' >> "$errors"
          ((error_count += 1))
          continue
        fi
        sleep "$SLEEP_SECONDS"
      fi

      jq -nc \
        --arg gameId "$game_id" \
        --arg title "$title" \
        --arg contentPath "$content_path" \
        --arg searchName "$search_name" \
        --arg sgdbId "$sgdb_id" \
        --arg ratio "$ratio" \
        --arg dimensions "$dimensions" \
        --arg imageId "$image_id" \
        --arg type "$image_type" \
        --arg style "$style" \
        --arg role "$role" \
        --arg url "$sanitized_url" \
        --arg file "$relative_file" \
        '{gameId:$gameId,title:$title,contentPath:$contentPath,searchName:$searchName,sgdbId:$sgdbId,role:$role,ratio:$ratio,dimensions:$dimensions,imageId:$imageId,type:$type,style:$style,url:$url,file:$file,provider:"steamgriddb"}' >> "$manifest"
    done
  done

  sleep "$SLEEP_SECONDS"
done < <(
  yq -r '.games | to_entries[] | select(.value.system == "nix") | [.key, (.value.metadata.name // ""), (.value.contentPath // "")] | @tsv' "$LIBRARY"
)

cat <<SUMMARY
Done.
  games scanned:       $game_count
  files downloaded:    $download_count
  existing skipped:    $skip_count
  errors/not found:    $error_count
  output:              $OUT_DIR
  manifest:            $manifest
  errors:              $errors
SUMMARY
